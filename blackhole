local function unloadScript()
	if isUnloaded then return end
	isUnloaded = true
	isActive = false
	isAutoReset97 = false
	isKillFarm = false
	killFarmThread = nil
	autoResetBusy = false
	respawnMovePending = false
	cachedRayParams = nil
	cachedRayChar = nil

	cancelActiveMove()
	stopFreeze()
	restoreCharacterState(LocalPlayer.Character)

	if hpWatchConn then hpWatchConn:Disconnect(); hpWatchConn = nil end
	for _, conn in ipairs(connections) do pcall(function() conn:Disconnect() end) end
	table.clear(connections)

	if skyPlatform and skyPlatform.Parent then pcall(function() skyPlatform:Destroy() end) end
	skyPlatform = nil

	local existingPlat = workspace:FindFirstChild(PLATFORM_NAME)
	if existingPlat then pcall(function() existingPlat:Destroy() end) end

	if activeGui and activeGui.Parent then pcall(function() activeGui:Destroy() end) end
	activeGui = nil

	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
	local existingGui = playerGui and playerGui:FindFirstChild("SkyPlatformControlGui")
	if existingGui then pcall(function() existingGui:Destroy() end) end

	customSetPoint, savedOriginCFrame, refreshActionButtonText, setPlatformFeedback = nil, nil, nil, nil
end

local function fetchNoCacheRaw(url)
	local sep = string.find(url, "?", 1, true) and "&" or "?"
	local cacheBustUrl = url .. sep .. "t=" .. tostring(os.time()) .. "_" .. tostring(math.random(1000, 9999))
	return game:HttpGet(cacheBustUrl, true)
end

local function triggerAutoUpdate(updateBtn)
	if isUnloaded or isUpdating then return end
	isUpdating = true

	local oldText = updateBtn and updateBtn.Text or "UPDATE"
	local oldColor = updateBtn and updateBtn.BackgroundColor3 or Color3.fromRGB(35, 115, 165)

	local function setBtnState(txt, col)
		if updateBtn and updateBtn.Parent then
			updateBtn.Text = txt
			if col then updateBtn.BackgroundColor3 = col end
		end
	end

	setBtnState("CHECKING...", Color3.fromRGB(165, 125, 35))

	task.spawn(function()
		local okFetch, rawCode = pcall(function()
			return fetchNoCacheRaw(SCRIPT_RAW_URL)
		end)

		if not okFetch or typeof(rawCode) ~= "string" or #rawCode == 0 then
			isUpdating = false
			setBtnState("FETCH FAIL", Color3.fromRGB(165, 45, 55))
			task.delay(1.8, function()
				if not isUnloaded and not isUpdating then
					setBtnState(oldText, oldColor)
				end
			end)
			return
		end

		setBtnState("UPDATING...", Color3.fromRGB(35, 135, 185))

		local compiledFn, compileErr = loadstring(rawCode)
		if not compiledFn then
			isUpdating = false
			warn("[SkyPlatform Update] Compile error:", compileErr)
			setBtnState("SYNTAX ERR", Color3.fromRGB(165, 45, 55))
			task.delay(2, function()
				if not isUnloaded and not isUpdating then
					setBtnState(oldText, oldColor)
				end
			end)
			return
		end

		unloadScript()
		task.wait(0.05)

		local okRun, runErr = pcall(compiledFn)
		if not okRun then
			warn("[SkyPlatform Update] Runtime error:", runErr)
		end
	end)
end

