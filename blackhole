-- ==========================================
-- FREEZE
-- ==========================================
local function stopFreeze()
	if freezeRenderConn then freezeRenderConn:Disconnect(); freezeRenderConn = nil end
	if freezeHeartConn then freezeHeartConn:Disconnect(); freezeHeartConn = nil end
	frozenCFrame = nil

	local char = LocalPlayer.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.PlatformStand = false
			pcall(function()
				hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
				hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
			end)
		end
		local hrp = getHrp(char)
		if hrp and hrp:IsA("BasePart") then hrp.Anchored = false end
	end
end

local function lockRootInPlace()
	if isUnloaded then return end
	local char = LocalPlayer.Character
	local hrp = getHrp(char)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not frozenCFrame then return end

	if hum then
		hum.PlatformStand = false
		pcall(function()
			hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
			hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
		end)
	end

	clearMovers(hrp)
	hrp.Anchored = true
	zeroCharacterVelocity(char)

	if (hrp.Position - frozenCFrame.Position).Magnitude > 0.05 then
		hrp.CFrame = frozenCFrame
	end
end

local function startFreezeAtCurrentSpot(hrp, overridePos)
	stopFreeze()
	if isUnloaded or not hrp or not hrp.Parent then return end

	local basePos = overridePos or hrp.Position
	frozenCFrame = CFrame.lookAt(basePos, basePos + hrp.CFrame.LookVector)
	lockRootInPlace()

	freezeRenderConn = RunService.RenderStepped:Connect(function()
		if isUnloaded or not frozenCFrame then stopFreeze(); return end
		lockRootInPlace()
	end)

	freezeHeartConn = RunService.Heartbeat:Connect(function()
		if isUnloaded or not frozenCFrame then stopFreeze(); return end
		lockRootInPlace()
	end)
end

-- ==========================================
-- QUÉT SỚM TRÊN ĐẦU (TỪ 400 STUD TRỞ ĐI) & TÌM HƯỚNG NGANG KHÔNG VẬT CẢN
-- ==========================================
local cachedRayParams = nil
local cachedRayChar = nil

local function getRayParams(char)
	if cachedRayParams and cachedRayChar == char then
		return cachedRayParams
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = {}
	if char then table.insert(ignore, char) end
	if skyPlatform and skyPlatform.Parent then table.insert(ignore, skyPlatform) end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character then table.insert(ignore, plr.Character) end
	end
	params.FilterDescendantsInstances = ignore
	cachedRayParams = params
	cachedRayChar = char
	return params
end

local function isBlockingPart(part)
	if not part or not part:IsA("BasePart") then return false end
	if part.Name == PLATFORM_NAME then return false end
	return true
end

local function rayHitsObstacle(origin, dirVec, char)
	local res = workspace:Raycast(origin, dirVec, getRayParams(char))
	return res and isBlockingPart(res.Instance) or false
end

local function hasOverheadObstacleEarly(currChar, currRoot)
	local base = currRoot.Position
	local upVec = Vector3.new(0, OVERHEAD_SCAN_STUDS, 0)
	local offsets = {
		Vector3.zero,
		Vector3.new(14, 0, 0),
		Vector3.new(-14, 0, 0),
		Vector3.new(0, 0, 14),
		Vector3.new(0, 0, -14),
		Vector3.new(10, 0, 10),
		Vector3.new(-10, 0, 10),
		Vector3.new(10, 0, -10),
		Vector3.new(-10, 0, -10),
	}

	for _, off in ipairs(offsets) do
		if rayHitsObstacle(base + off, upVec, currChar) then
			return true
		end
	end

	return false
end

local function isHorizontalPathClear(originPos, dirUnit, dist, char)
	for _, yOffset in ipairs({ -8, 0, 25, 50, 75, 100 }) do
		local rayOrigin = Vector3.new(originPos.X, originPos.Y + yOffset, originPos.Z)
		if rayHitsObstacle(rayOrigin, dirUnit * dist, char) then
			return false
		end
	end
	return true
end

local function findClearHorizontalDodgePos(currentPos, dist, char)
	local startAngle = math.random() * math.pi * 2
	local steps = 64
	for i = 0, steps - 1 do
		local angle = startAngle + (i / steps) * math.pi * 2
		local dir = Vector3.new(math.cos(angle), 0, math.sin(angle)).Unit
		if isHorizontalPathClear(currentPos, dir, dist, char) then
			return Vector3.new(
				currentPos.X + dir.X * dist,
				currentPos.Y,
				currentPos.Z + dir.Z * dist
			)
		end
	end

	local fallbackDir = Vector3.new(math.cos(startAngle), 0, math.sin(startAngle)).Unit
	return Vector3.new(
		currentPos.X + fallbackDir.X * dist,
		currentPos.Y,
		currentPos.Z + fallbackDir.Z * dist
	)
end

-- ==========================================
-- DI CHUYỂN BẰNG TWEEN
-- ==========================================
local function cancelActiveMove()
	moveToken += 1
	activeMoveSequence = false
	if activeTween then
		pcall(function() activeTween:Cancel() end)
		activeTween = nil
	end
	local hrp = getHrp(LocalPlayer.Character)
	if hrp then clearMovers(hrp) end
end

local function tweenSingleSegment(targetPos, myToken, onStepCheck, customSpeed)
	if isUnloaded or not activeMoveSequence or moveToken ~= myToken then return false, false end
	local char = LocalPlayer.Character
	local hrp = getHrp(char)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not isAliveChar(char) or not hrp or not hum then return false, false end

	hrp.Anchored = false
	clearMovers(hrp)
	zeroCharacterVelocity(char)

	local dist = (hrp.Position - targetPos).Magnitude
	if dist <= 1.2 then
		hrp.CFrame = CFrame.lookAt(targetPos, targetPos + hrp.CFrame.LookVector)
		zeroCharacterVelocity(char)
		return true, false
	end

	local speed = math.max(customSpeed or TWEEN_SPEED, 1)
	local duration = math.max(dist / speed, 0.02)
	local goalCFrame = CFrame.lookAt(targetPos, targetPos + hrp.CFrame.LookVector)

	local tween = TweenService:Create(
		hrp,
		TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
		{ CFrame = goalCFrame }
	)
	activeTween = tween

	local completed = false
	local doneConn = tween.Completed:Connect(function()
		completed = true
	end)

	tween:Play()

	local elapsed = 0
	local scanAccum = SCAN_INTERVAL
	while not completed and not isUnloaded and activeMoveSequence and (moveToken == myToken) do
		local c = LocalPlayer.Character
		local r = getHrp(c)
		local h = c and c:FindFirstChildOfClass("Humanoid")
		if not c or not c.Parent or not r or not r.Parent or not h or h:GetState() == Enum.HumanoidStateType.Dead then
			pcall(function() tween:Cancel() end)
			doneConn:Disconnect()
			if activeTween == tween then activeTween = nil end
			return false, false
		end

		if onStepCheck then
			scanAccum += elapsed == 0 and SCAN_INTERVAL or 0
			while scanAccum >= SCAN_INTERVAL do
				scanAccum -= SCAN_INTERVAL
				if onStepCheck(c, r, targetPos) then
					pcall(function() tween:Cancel() end)
					doneConn:Disconnect()
					if activeTween == tween then activeTween = nil end
					zeroCharacterVelocity(c)
					return false, true
				end
			end
		end

		local dt = RunService.Heartbeat:Wait()
		elapsed += dt
		scanAccum += dt
		if elapsed > duration + 1.5 then
			break
		end
	end

	doneConn:Disconnect()
	if activeTween == tween then activeTween = nil end

	if isUnloaded or not activeMoveSequence or moveToken ~= myToken then
		pcall(function() tween:Cancel() end)
		return false, false
	end

	local finalRoot = getHrp(LocalPlayer.Character)
	if finalRoot then
		finalRoot.CFrame = goalCFrame
		zeroCharacterVelocity(LocalPlayer.Character)
	end
	return true, false
end

local function climbStraightSegment(targetY, myToken)
	while not isUnloaded and activeMoveSequence and (moveToken == myToken) do
		local c = LocalPlayer.Character
		local r = getHrp(c)
		if not c or not r then return false end
		if r.Position.Y >= targetY - 1.5 then return true end

		local goalPos = Vector3.new(r.Position.X, targetY, r.Position.Z)
		if not tweenSingleSegment(goalPos, myToken, nil, TWEEN_SPEED) then
			return false
		end
	end
	return false
end

local function climbToSkyWith400Scan(startBaseY, targetY, myToken)
	local stage400Y = startBaseY + STAGE_1_CLIMB_STUDS

	-- 1. Từ 0 đến 400 stud: bay thẳng lên, không quét vật cản
	if targetY > stage400Y then
		while not isUnloaded and activeMoveSequence and (moveToken == myToken) do
			local c = LocalPlayer.Character
			local r = getHrp(c)
			if not c or not r then return false end
			if r.Position.Y >= stage400Y - 1.5 then break end

			local goal400Pos = Vector3.new(r.Position.X, stage400Y, r.Position.Z)
			if not tweenSingleSegment(goal400Pos, myToken, nil, TWEEN_SPEED) then
				return false
			end
		end
	else
		return climbStraightSegment(targetY, myToken)
	end

	if isUnloaded or not activeMoveSequence or moveToken ~= myToken then return false end

	-- 2. Từ 400 stud trở đi: quét sớm trên đầu; có vật cản thì tìm hướng ngang thoáng né 450 stud rồi bay lên tiếp
	while not isUnloaded and activeMoveSequence and (moveToken == myToken) do
		local c = LocalPlayer.Character
		local r = getHrp(c)
		if not c or not r then return false end
		if r.Position.Y >= targetY - 1.5 then return true end

		local ok, hitObstacle = tweenSingleSegment(
			Vector3.new(r.Position.X, targetY, r.Position.Z),
			myToken,
			function(currChar, currRoot)
				return hasOverheadObstacleEarly(currChar, currRoot)
			end,
			TWEEN_SPEED
		)

		if ok then return true end
		if not hitObstacle then return false end

		local cNow = LocalPlayer.Character
		local rNow = getHrp(cNow)
		if not cNow or not rNow then return false end

		local dodgePos = findClearHorizontalDodgePos(rNow.Position, DODGE_HORIZONTAL_STUDS, cNow)
		if not tweenSingleSegment(dodgePos, myToken, nil, DODGE_SPEED) then
			return false
		end

		local nextClimbY = math.max(targetY, rNow.Position.Y + (SKY_CLIMB_STUDS - STAGE_1_CLIMB_STUDS))
		if not climbStraightSegment(nextClimbY, myToken) then
			return false
		end
	end

	return false
end

local function moveViaSkyToTarget(targetPos, onComplete)
	if isUnloaded then return end
	local char = LocalPlayer.Character
	local hrp = getHrp(char)
	if not isAliveChar(char) or not hrp then return end

	cancelActiveMove()
	stopFreeze()

	local myToken = moveToken
	activeMoveSequence = true

	task.spawn(function()
		local function cleanupFail()
			if moveToken == myToken then activeMoveSequence = false end
			restoreCharacterState(LocalPlayer.Character)
		end

		local function abortIfDone()
			if isUnloaded or moveToken ~= myToken then
				cleanupFail()
				return true
			end
			return false
		end

		local startPos = hrp.Position
		local skyGoalY = math.max(startPos.Y + SKY_CLIMB_STUDS, targetPos.Y)
		if not climbToSkyWith400Scan(startPos.Y, skyGoalY, myToken) then
			cleanupFail()
			return
		end
		if abortIfDone() then return end

		local curRoot = getHrp(LocalPlayer.Character)
		local climbY = curRoot and curRoot.Position.Y or skyGoalY
		local aboveTargetPos = Vector3.new(targetPos.X, climbY, targetPos.Z)
		if not tweenSingleSegment(aboveTargetPos, myToken, nil, TWEEN_SPEED) then
			cleanupFail()
			return
		end
		if abortIfDone() then return end

		if not tweenSingleSegment(targetPos, myToken, nil, TWEEN_SPEED) then
			cleanupFail()
			return
		end
		if abortIfDone() then return end

		activeMoveSequence = false
		local finalChar = LocalPlayer.Character
		local finalRoot = getHrp(finalChar)
		if finalChar and finalRoot then
			finalRoot.CFrame = CFrame.lookAt(targetPos, targetPos + finalRoot.CFrame.LookVector)
			zeroCharacterVelocity(finalChar)
			if onComplete then onComplete(finalChar, finalRoot, targetPos) end
			if not frozenCFrame then
				restoreCharacterState(finalChar)
			end
		end
	end)
end

local function getTargetStandPos()
	if customSetPoint then
		return customSetPoint
	end
	local plat = initInitialPlatform()
	local topY = plat and (plat.Position.Y + (plat.Size.Y / 2) + 3.2) or FIXED_PLATFORM_POS.Y
	return Vector3.new(plat and plat.Position.X or FIXED_PLATFORM_POS.X, topY, plat and plat.Position.Z or FIXED_PLATFORM_POS.Z)
end

-- ==========================================
-- KILL FARM (OWNER): BAY NÉ VẬT CẢN -> FREEZE -> SPAM M1 CLIENTSIDE
-- ==========================================
local function stopKillFarm(unfreeze)
	isKillFarm = false
	killFarmThread = nil
	if unfreeze ~= false then
		stopFreeze()
	end
end

local function fireClientM1()
	local mouse = LocalPlayer:GetMouse()
	local x = (mouse and mouse.X and mouse.X > 0) and mouse.X or 500
	local y = (mouse and mouse.Y and mouse.Y > 0) and mouse.Y or 500

	pcall(function()
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
		task.wait(0.015)
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
	end)
	pcall(function()
		if typeof(mouse1click) == "function" then
			mouse1click()
		elseif typeof(mouse1press) == "function" and typeof(mouse1release) == "function" then
			mouse1press()
			task.wait(0.015)
			mouse1release()
		end
	end)
end

local function startKillFarmLoop()
	if killFarmThread then return end
	killFarmThread = task.spawn(function()
		while not isUnloaded and role == "owner" and isKillFarm do
			local c = LocalPlayer.Character
			if isAliveChar(c) then
				fireClientM1()
			end
			task.wait(M1_SPAM_INTERVAL)
		end
		killFarmThread = nil
	end)
end

local function toggleKillFarm(enabled)
	if isUnloaded or role ~= "owner" then return end
	if not enabled then
		stopKillFarm(true)
		return
	end

	local char = LocalPlayer.Character
	local hrp = getHrp(char)
