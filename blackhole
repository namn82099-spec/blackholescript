local function createButton(parent, name, size, pos, bgColor, text, font, textSize)
	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.Size = size
	btn.Position = pos
	btn.BackgroundColor3 = bgColor
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Font = font or Enum.Font.GothamBold
	btn.TextSize = textSize or 12
	btn.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = btn
	return btn
end

local function buildGui()
	if isUnloaded then return end
	local playerGui = LocalPlayer:WaitForChild("PlayerGui")
	local existing = playerGui:FindFirstChild("SkyPlatformControlGui")
	if existing then existing:Destroy() end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "SkyPlatformControlGui"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui
	activeGui = screenGui

	local frame = Instance.new("Frame")
	frame.Name = "MainFrame"
	frame.Size = UDim2.fromOffset(220, 180)
	frame.Position = UDim2.new(0.5, -110, 0.2, 0)
	frame.BackgroundColor3 = Color3.fromRGB(28, 30, 36)
	frame.BorderSizePixel = 0
	frame.Active = true
	frame.Draggable = true
	frame.Parent = screenGui

	local frameCorner = Instance.new("UICorner")
	frameCorner.CornerRadius = UDim.new(0, 8)
	frameCorner.Parent = frame

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -16, 0, 22)
	title.Position = UDim2.fromOffset(8, 6)
	title.BackgroundTransparency = 1
	title.Text = (role == "owner") and "panel owner" or "panel alt"
	title.TextColor3 = (role == "owner") and Color3.fromRGB(100, 210, 255) or Color3.fromRGB(255, 190, 80)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 13
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = frame

	local actionBtn = createButton(frame, "ActionButton", UDim2.new(1, -16, 0, 34), UDim2.fromOffset(8, 32), Color3.fromRGB(50, 54, 65), "TẮT", Enum.Font.GothamBold, 14)

	refreshActionButtonText = function()
		if isUnloaded then return end
		if isButtonMode then
			actionBtn.Text = "LÊN PLATFORM (BẤM)"
			actionBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 210)
		elseif isActive then
			actionBtn.Text = "BẬT"
			actionBtn.BackgroundColor3 = Color3.fromRGB(45, 170, 95)
		else
			actionBtn.Text = "TẮT"
			actionBtn.BackgroundColor3 = Color3.fromRGB(170, 55, 55)
		end
	end

	actionBtn.MouseButton1Click:Connect(function()
		if isUnloaded then return end
		respawnTweenPending = false
		if isButtonMode then
			goUpToPlatform()
		else
			isActive = not isActive
			refreshActionButtonText()
			if isActive then goUpToPlatform() else goBackToOrigin() end
		end
	end)

	local checkBtn = createButton(frame, "ModeCheckButton", UDim2.new(1, -16, 0, 28), UDim2.fromOffset(8, 74), Color3.fromRGB(40, 43, 52), "[ ] Chế độ Nút bấm", Enum.Font.GothamSemibold, 12)
	checkBtn.MouseButton1Click:Connect(function()
		if isUnloaded then return end
		isButtonMode = not isButtonMode
		if isButtonMode then respawnTweenPending = false end
		checkBtn.Text = isButtonMode and "[✓] Chế độ Nút bấm" or "[ ] Chế độ Nút bấm"
		checkBtn.BackgroundColor3 = isButtonMode and Color3.fromRGB(60, 95, 140) or Color3.fromRGB(40, 43, 52)
		refreshActionButtonText()
	end)

	if role == "owner" then
		local setPlatBtn = createButton(frame, "SetPlatformButton", UDim2.new(1, -16, 0, 28), UDim2.fromOffset(8, 108), Color3.fromRGB(85, 65, 145), "SET PLATFORM", Enum.Font.GothamBold, 11)
		local feedbackToken = 0

		setPlatformFeedback = function(vec3)
			if isUnloaded then return end
			feedbackToken += 1
			local myFb = feedbackToken
			setPlatBtn.Text = string.format("SET: %d, %d, %d", math.round(vec3.X), math.round(vec3.Y), math.round(vec3.Z))
			setPlatBtn.BackgroundColor3 = Color3.fromRGB(45, 155, 95)
			task.delay(1.5, function()
				if not isUnloaded and feedbackToken == myFb and setPlatBtn and setPlatBtn.Parent then
					setPlatBtn.Text = "SET PLATFORM"
					setPlatBtn.BackgroundColor3 = Color3.fromRGB(85, 65, 145)
				end
			end)
		end

		setPlatBtn.MouseButton1Click:Connect(setPointOnly)
	else
		local reset97Btn = createButton(frame, "AutoReset97Button", UDim2.new(1, -16, 0, 28), UDim2.fromOffset(8, 108), Color3.fromRGB(40, 43, 52), "[ ] Reset HP<=97 (7s->R->2s)", Enum.Font.GothamSemibold, 11)
		reset97Btn.MouseButton1Click:Connect(function()
			if isUnloaded then return end
			isAutoReset97 = not isAutoReset97
			if isAutoReset97 then
				respawnTweenPending = false
				reset97Btn.Text = "[✓] Reset HP<=97 (7s->R->2s)"
				reset97Btn.BackgroundColor3 = Color3.fromRGB(145, 85, 40)
				if LocalPlayer.Character then attachHp97Watcher(LocalPlayer.Character) end
			else
				autoResetBusy = false
				reset97Btn.Text = "[ ] Reset HP<=97 (7s->R->2s)"
				reset97Btn.BackgroundColor3 = Color3.fromRGB(40, 43, 52)
			end
		end)
	end

	local unloadBtn = createButton(frame, "UnloadButton", UDim2.new(1, -16, 0, 26), UDim2.fromOffset(8, 144), Color3.fromRGB(120, 35, 45), "UNLOAD", Enum.Font.GothamBold, 11)
	unloadBtn.TextColor3 = Color3.fromRGB(255, 230, 230)
	unloadBtn.MouseButton1Click:Connect(unloadScript)

	refreshActionButtonText()
end

buildGui()
