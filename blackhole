			stopKillFarm(false)
			cancelActiveMove()
			stopFreeze()

			if role == "alt" and (not isAutoReset97) and (not isButtonMode) and isActive and savedOriginCFrame then
				respawnMovePending = true
			end
		end)
	end
end

if LocalPlayer.Character then hookCharacter(LocalPlayer.Character) end

trackConn(LocalPlayer.CharacterAdded:Connect(function(newChar)
	if isUnloaded then return end
	hookCharacter(newChar)

	if role == "alt" and (not isAutoReset97) and (not isButtonMode) and isActive and respawnMovePending and savedOriginCFrame then
		respawnMovePending = false
		local hrp = newChar:WaitForChild("HumanoidRootPart", 10)
		local hum = newChar:WaitForChild("Humanoid", 10)
		if not isUnloaded and hrp and hum then
			local elapsed = 0
			while not isUnloaded and hum:GetState() == Enum.HumanoidStateType.Dead and elapsed < 3 do
				elapsed += task.wait(0.05)
			end
			if isUnloaded then return end
			task.wait(0.25)
			if isUnloaded then return end
			moveViaSkyToTarget(savedOriginCFrame.Position, function(finalChar)
				zeroCharacterVelocity(finalChar)
				savedOriginCFrame = nil
			end)
		end
	end
end))

