local function forceResetCharacter(char)
	if not char then return end
	cancelActiveMove()
	stopFreeze()

	local hum = char:FindFirstChildOfClass("Humanoid")
	pcall(function()
		if hum then
			hum.Health = 0
			hum:ChangeState(Enum.HumanoidStateType.Dead)
		end
	end)
	pcall(function() char:BreakJoints() end)
end

local function triggerManualResetByCommand()
	if isUnloaded or role ~= "alt" or autoResetBusy then return end
	autoResetBusy = true

	task.spawn(function()
		forceResetCharacter(LocalPlayer.Character)

		task.wait(6.5)
		if isUnloaded then autoResetBusy = false; return end
		pressKeyR()
		autoResetBusy = false
	end)
end

local function triggerAutoReset97Flow(char)
	if isUnloaded or role ~= "alt" or not isAutoReset97 or autoResetBusy then return end
	autoResetBusy = true

	task.spawn(function()
		forceResetCharacter(char)

		task.wait(7)
		if isUnloaded or not isAutoReset97 then autoResetBusy = false; return end
		pressKeyR()

		task.wait(2)
		autoResetBusy = false
		if not isUnloaded and isAutoReset97 then
			respawnMovePending = false
			goUpToPlatform()
		end
	end)
end

local function attachHp97Watcher(char)
	if hpWatchConn then hpWatchConn:Disconnect(); hpWatchConn = nil end
	if isUnloaded or role ~= "alt" or not char then return end

	local hum = char:WaitForChild("Humanoid", 10)
	if isUnloaded or not hum then return end

	local firedForChar = false
	local function checkHp(hp)
		if isUnloaded or firedForChar or not isAutoReset97 or autoResetBusy then return end
		if hp > 0 and hp <= 97 then
			firedForChar = true
			triggerAutoReset97Flow(char)
		end
	end

	checkHp(hum.Health)
	hpWatchConn = hum.HealthChanged:Connect(checkHp)
end

-- ==========================================
-- ĐỒNG BỘ ĐIỂM SET & LỆNH CHAT ($re, $tspeed, $dspeed, $go, $cmd_ta, $cmd_tv)
-- ==========================================
local SYNC_PREFIX = "__SKYPLAT_POINT__:"

local function parseSyncMessage(msg)
	if typeof(msg) ~= "string" then return nil end
	local idx = string.find(msg, SYNC_PREFIX, 1, true)
	if not idx then return nil end
	local body = string.sub(msg, idx + #SYNC_PREFIX)
	local x, y, z = string.match(body, "^%s*([%-+%d%.]+)%s*,%s*([%-+%d%.]+)%s*,%s*([%-+%d%.]+)%s*")
	local nx, ny, nz = tonumber(x), tonumber(y), tonumber(z)
	return (nx and ny and nz) and Vector3.new(nx, ny, nz) or nil
end

local function sendSyncChat(vec3)
	if isUnloaded then return end
	local payload = string.format("%s%.2f,%.2f,%.2f", SYNC_PREFIX, vec3.X, vec3.Y, vec3.Z)
	sendRawChat(payload)
end

local function announceCommandsEN()
	local lines = {
		"Commands: re (alt reset + 6.5s press R), tspeed{num} (set tween speed + save), dspeed{num} (set dodge speed + save)",
		"More commands: go (tween to set plat with obstacle dodge), cmd_ta (EN list), cmd_tv (VI list)"
	}
	for _, line in ipairs(lines) do
		sendAntiTagChat(line)
		task.wait(0.25)
	end
end

local function announceCommandsVI()
	local lines = {
		"Lenh: re (alt tu reset + doi 6.5s an R), tspeed{so} (doi tween speed + luu), dspeed{so} (doi dodge speed + luu)",
		"Them lenh: go (bay len diem set co ne vat can), cmd_ta (danh sach tieng Anh), cmd_tv (danh sach tieng Viet)"
	}
	for _, line in ipairs(lines) do
		sendAntiTagChat(line)
		task.wait(0.25)
	end
end

local function handleOwnerChatCommand(rawMsg)
	if isUnloaded or typeof(rawMsg) ~= "string" then return end
	local msg = rawMsg:match("^%s*(.-)%s*$") or ""
	local lower = string.lower(msg)

	if lower == "$re" then
		if role == "alt" then
			triggerManualResetByCommand()
		end
		return
	end

	local tValStr = lower:match("^%$tspeed%s*([%d%.]+)$")
	if tValStr then
		local num = tonumber(tValStr)
		if num and num > 0 then
			TWEEN_SPEED = num
			saveSpeeds()
			if role == "alt" then
				sendAntiTagChat(string.format("Tween speed set to %g and saved", TWEEN_SPEED))
			end
		end
		return
	end

	local dValStr = lower:match("^%$dspeed%s*([%d%.]+)$")
	if dValStr then
		local num = tonumber(dValStr)
		if num and num > 0 then
			DODGE_SPEED = num
			saveSpeeds()
			if role == "alt" then
				sendAntiTagChat(string.format("Dodge speed set to %g and saved", DODGE_SPEED))
			end
		end
		return
	end

	if lower == "$go" then
		stopKillFarm(true)
		respawnMovePending = false
		if not isButtonMode then
			isActive = true
			if refreshActionButtonText then refreshActionButtonText() end
		end
		goUpToPlatform()
		return
	end

	if lower == "$cmd_ta" then
		if role == "alt" then
			task.spawn(announceCommandsEN)
		end
		return
	end

	if lower == "$cmd_tv" then
		if role == "alt" then
			task.spawn(announceCommandsVI)
		end
		return
	end

	if role == "alt" then
		local pos = parseSyncMessage(msg)
		if pos then
			customSetPoint = pos
		end
	end
end

pcall(function()
