-- ĐỒNG BỘ ĐIỂM SET QUA CHAT (__SKYPLAT_POINT__)
-- ==========================================
local SYNC_PREFIX = "__SKYPLAT_POINT__:"

local function parseSyncMessage(msg)
	if typeof(msg) ~= "string" then return nil end
	local idx = string.find(msg, SYNC_PREFIX, 1, true)
	if not idx then return nil end
	local body = string.sub(msg, idx + #SYNC_PREFIX)
	local x, y, z = string.match(body, "^%s*([%-+%d%.]+)%s*,%s*([%-+%d%.]+)%s*,%s*([%-+%d%.]+)%s*")
	local nx, ny, nz = tonumber(x), tonumber(y), tonumber(z)
	return (nx and ny and nz) and Vector3.new(nx, ny, nz) or nil
end

local function sendSyncChat(vec3)
	if isUnloaded then return end
	local payload = string.format("%s%.2f,%.2f,%.2f", SYNC_PREFIX, vec3.X, vec3.Y, vec3.Z)
	pcall(function()
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			local general = TextChatService:FindFirstChild("TextChannels")
				and (TextChatService.TextChannels:FindFirstChild("RBXGeneral") or TextChatService.TextChannels:GetChildren()[1])
			if general and general:IsA("TextChannel") then
				general:SendAsync(payload)
				return
			end
		end
	end)
	pcall(function()
		local chatEvents = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
		local sayMsg = chatEvents and chatEvents:FindFirstChild("SayMessageRequest")
		if sayMsg then sayMsg:FireServer(payload, "All") end
	end)
end

if role == "alt" then
	pcall(function()
		trackConn(TextChatService.MessageReceived:Connect(function(msg)
			if isUnloaded then return end
			local sender = msg.TextSource and Players:GetPlayerByUserId(msg.TextSource.UserId)
			if sender and sender.Name == OwnerName then
				local pos = parseSyncMessage(msg.Text)
				if pos then customSetPoint = pos end
			end
		end))
	end)

	trackConn(Players.PlayerChatted:Connect(function(_, sender, message)
		if isUnloaded then return end
		if sender and sender.Name == OwnerName then
			local pos = parseSyncMessage(message)
			if pos then customSetPoint = pos end
		end
	end))
end

local function setPointOnly()
