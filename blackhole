-- ==========================================
-- CẤU HÌNH CHỦ NHÂN & PLATFORM
-- ==========================================
local OwnerName = "tinhtrungcovij" -- Thay tên tài khoản chính vào đây

local FIXED_PLATFORM_POS = Vector3.new(0, 1000, 0)
local PLATFORM_SIZE = Vector3.new(50, 2, 50)
local PLATFORM_NAME = "SharedSkyPlatform_Client"
local TWEEN_SPEED = 100 -- studs / giây

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

-- Kiểm tra username trong game có đúng bằng OwnerName hay không
local role = (LocalPlayer.Name == OwnerName) and "owner" or "alt"

-- Trạng thái
local isActive = false
local isButtonMode = false -- Áp dụng cho cả owner và alt
local activeTween = nil
local noclipConn = nil
local freezeConn = nil
local frozenCFrame = nil
local altResetTriggered = false
local respawnTweenPending = false

local savedOriginCFrame = nil
local refreshActionButtonText = nil

local function isAliveChar(char)
	if not char then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	return hum ~= nil and hrp ~= nil and hum.Parent ~= nil and hrp.Parent ~= nil and hum:GetState() ~= Enum.HumanoidStateType.Dead
end

-- ==========================================
-- DUY TRÌ DUY NHẤT 1 PLATFORM 50x50
-- ==========================================
local skyPlatform = nil

local function ensureSinglePlatform()
	for _, obj in ipairs(workspace:GetChildren()) do
		if obj:IsA("BasePart") and obj.Name == PLATFORM_NAME and obj ~= skyPlatform then
			obj:Destroy()
		end
	end

	if skyPlatform and skyPlatform.Parent then
		skyPlatform.Size = PLATFORM_SIZE
		skyPlatform.Position = FIXED_PLATFORM_POS
		skyPlatform.Anchored = true
		skyPlatform.CanCollide = true
		return skyPlatform
	end

	local part = Instance.new("Part")
	part.Name = PLATFORM_NAME
	part.Size = PLATFORM_SIZE
	part.Position = FIXED_PLATFORM_POS
	part.Anchored = true
	part.CanCollide = true
	part.Material = Enum.Material.SmoothPlastic
	part.Color = (role == "owner") and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(255, 170, 0)
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = workspace

	skyPlatform = part
	return part
end

ensureSinglePlatform()

-- ==========================================
-- NOCLIP & FREEZE TẠI CHỖ (KHÔNG SỬA SPEED/JUMP)
-- ==========================================
local function setNoclip(enabled)
	if noclipConn then
		noclipConn:Disconnect()
		noclipConn = nil
	end

	if enabled then
		noclipConn = RunService.Stepped:Connect(function()
			local char = LocalPlayer.Character
			if not char then return end
			for _, obj in ipairs(char:GetDescendants()) do
				if obj:IsA("BasePart") then
					obj.CanCollide = false
				end
			end
		end)
	else
		local char = LocalPlayer.Character
		if not char then return end
		for _, obj in ipairs(char:GetDescendants()) do
			if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart" then
				obj.CanCollide = true
			end
		end
	end
end

local function stopFreeze()
	if freezeConn then
		freezeConn:Disconnect()
		freezeConn = nil
	end
	frozenCFrame = nil

	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		hrp.Anchored = false
	end
end

local function startFreezeAtCurrentSpot(hrp)
	stopFreeze()
	if not hrp or not hrp.Parent then return end

	frozenCFrame = hrp.CFrame
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	hrp.Anchored = true

	freezeConn = RunService.Heartbeat:Connect(function()
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root or not root.Parent or not frozenCFrame then
			stopFreeze()
			return
		end
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		if not root.Anchored then
			root.Anchored = true
		end
		if (root.Position - frozenCFrame.Position).Magnitude > 0.05 then
			root.CFrame = frozenCFrame
		end
	end)
end

-- ==========================================
-- TWEEN THEO TỐC ĐỘ 100 STUD/S
-- ==========================================
local function tweenToCFrame(targetCFrame, onComplete)
	local char = LocalPlayer.Character
	if not isAliveChar(char) then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")

	if activeTween then
		activeTween:Cancel()
		activeTween = nil
	end

	stopFreeze()

	local distance = (hrp.Position - targetCFrame.Position).Magnitude
	local duration = math.max(distance / TWEEN_SPEED, 0.05)

	local info = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
	local tween = TweenService:Create(hrp, info, { CFrame = targetCFrame })
	activeTween = tween

	tween.Completed:Connect(function(playbackState)
		if activeTween == tween then
			activeTween = nil
		end
		if playbackState == Enum.PlaybackState.Completed and onComplete then
			local currentChar = LocalPlayer.Character
			local currentRoot = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
			if currentChar and currentRoot then
				onComplete(currentChar, currentRoot)
			end
		end
	end)

	tween:Play()
end

local function getPlatformStandCFrame()
	local plat = ensureSinglePlatform()
	local topY = plat.Position.Y + (plat.Size.Y / 2) + 3.2
	return CFrame.new(plat.Position.X, topY, plat.Position.Z)
end

-- ==========================================
-- HÀNH ĐỘNG LÊN PLATFORM / TWEEN VỀ VỊ TRÍ CŨ
-- ==========================================
local function goUpToPlatform()
	local char = LocalPlayer.Character
	if not isAliveChar(char) then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")

	if not savedOriginCFrame then
		savedOriginCFrame = hrp.CFrame
	end

	local targetCF = getPlatformStandCFrame()

	if role == "owner" then
		-- Máy owner: noclip khi tween lên, xong thì noclip off để đứng trên platform
		setNoclip(true)
		tweenToCFrame(targetCF, function(_, root)
			setNoclip(false)
			root.AssemblyLinearVelocity = Vector3.zero
		end)
	else
		-- Máy alt: tween lên với noclip off, đến nơi noclip off và freeze tại chỗ
		setNoclip(false)
		tweenToCFrame(targetCF, function(_, root)
			setNoclip(false)
			startFreezeAtCurrentSpot(root)
		end)
	end
end

local function goBackToOrigin()
	local char = LocalPlayer.Character
	if not isAliveChar(char) then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")

	stopFreeze()
	setNoclip(true)

	local backCF = savedOriginCFrame or hrp.CFrame
	tweenToCFrame(backCF, function(_, root)
		setNoclip(false)
		savedOriginCFrame = nil
		root.AssemblyLinearVelocity = Vector3.zero
	end)
end

-- ==========================================
-- RESET KIỂU NAMELESS ADMIN (CHỈ MÁY ALT, 1 LẦN / LẦN SPAWN)
-- ==========================================
local function namelessStyleResetAlt()
	if role ~= "alt" or altResetTriggered then return end
	local char = LocalPlayer.Character
	if not char then return end

	altResetTriggered = true
	stopFreeze()
	setNoclip(false)

	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.Sit = false
		pcall(function()
			hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
			hum:ChangeState(Enum.HumanoidStateType.Dead)
		end)
		hum.Health = 0
	end

	task.delay(0.05, function()
		if char and char.Parent then
			pcall(function()
				char:BreakJoints()
			end)
		end
	end)
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if role == "alt" and input.KeyCode == Enum.KeyCode.R then
		namelessStyleResetAlt()
	end
end)

-- ==========================================
-- THEO DÕI CHẾT & RESPAWN (TỰ TWEEN VỀ KHI CHẾT TRÊN ALT TOGGLE)
-- ==========================================
local function hookCharacter(char)
	altResetTriggered = false
	stopFreeze()

	local hum = char:WaitForChild("Humanoid", 10)
	if hum then
		hum.Died:Connect(function()
			if activeTween then
				activeTween:Cancel()
				activeTween = nil
			end
			stopFreeze()
			setNoclip(false)

			-- Nếu máy alt đang bật ở chế độ toggle (không phải nút bấm), đánh dấu để tự tween về khi có nhân vật mới
			if role == "alt" and (not isButtonMode) and isActive and savedOriginCFrame then
				respawnTweenPending = true
			end
		end)
	end
end

if LocalPlayer.Character then
	hookCharacter(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(function(newChar)
	ensureSinglePlatform()
	hookCharacter(newChar)

	if role == "alt" and (not isButtonMode) and isActive and respawnTweenPending and savedOriginCFrame then
		respawnTweenPending = false
		local hrp = newChar:WaitForChild("HumanoidRootPart", 10)
		if hrp then
			task.wait(0.25)
			setNoclip(true)
			tweenToCFrame(savedOriginCFrame, function(_, root)
				setNoclip(false)
				savedOriginCFrame = nil
				root.AssemblyLinearVelocity = Vector3.zero
			end)
		end
	end
end)

-- ==========================================
-- TẠO GUI (CẢ OWNER VÀ ALT ĐỀU CÓ NÚT CHECK NÚT BẤM)
-- ==========================================
local function buildGui()
	local playerGui = LocalPlayer:WaitForChild("PlayerGui")
	local existing = playerGui:FindFirstChild("SkyPlatformControlGui")
	if existing then
		existing:Destroy()
	end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "SkyPlatformControlGui"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui

	local frame = Instance.new("Frame")
	frame.Name = "MainFrame"
	frame.Size = UDim2.fromOffset(220, 112)
	frame.Position = UDim2.new(0.5, -110, 0.2, 0)
	frame.BackgroundColor3 = Color3.fromRGB(28, 30, 36)
	frame.BorderSizePixel = 0
	frame.Active = true
	frame.Draggable = true
	frame.Parent = screenGui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = frame

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -16, 0, 22)
	title.Position = UDim2.fromOffset(8, 6)
	title.BackgroundTransparency = 1
	title.Text = (role == "owner") and "panel owner" or "panel alt"
	title.TextColor3 = (role == "owner") and Color3.fromRGB(100, 210, 255) or Color3.fromRGB(255, 190, 80)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 13
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = frame

	local actionBtn = Instance.new("TextButton")
	actionBtn.Name = "ActionButton"
	actionBtn.Size = UDim2.new(1, -16, 0, 34)
	actionBtn.Position = UDim2.fromOffset(8, 32)
	actionBtn.BackgroundColor3 = Color3.fromRGB(50, 54, 65)
	actionBtn.Text = "TẮT"
	actionBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	actionBtn.Font = Enum.Font.GothamBold
	actionBtn.TextSize = 14
	actionBtn.Parent = frame

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 6)
	btnCorner.Parent = actionBtn

	refreshActionButtonText = function()
		if isButtonMode then
			actionBtn.Text = "LÊN PLATFORM (BẤM)"
			actionBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 210)
		else
			if isActive then
				actionBtn.Text = "BẬT"
				actionBtn.BackgroundColor3 = Color3.fromRGB(45, 170, 95)
			else
				actionBtn.Text = "TẮT"
				actionBtn.BackgroundColor3 = Color3.fromRGB(170, 55, 55)
			end
		end
	end

	actionBtn.MouseButton1Click:Connect(function()
		if isButtonMode then
			goUpToPlatform()
		else
			isActive = not isActive
			refreshActionButtonText()
			if isActive then
				respawnTweenPending = false
				goUpToPlatform()
			else
				respawnTweenPending = false
				goBackToOrigin()
			end
		end
	end)

	local checkBtn = Instance.new("TextButton")
	checkBtn.Name = "ModeCheckButton"
	checkBtn.Size = UDim2.new(1, -16, 0, 28)
	checkBtn.Position = UDim2.fromOffset(8, 74)
	checkBtn.BackgroundColor3 = Color3.fromRGB(40, 43, 52)
	checkBtn.Text = "[ ] Chế độ Nút bấm"
	checkBtn.TextColor3 = Color3.fromRGB(225, 225, 225)
	checkBtn.Font = Enum.Font.GothamSemibold
	checkBtn.TextSize = 12
	checkBtn.Parent = frame

	local checkCorner = Instance.new("UICorner")
	checkCorner.CornerRadius = UDim.new(0, 6)
	checkCorner.Parent = checkBtn

	checkBtn.MouseButton1Click:Connect(function()
		isButtonMode = not isButtonMode
		if isButtonMode then
			respawnTweenPending = false
			checkBtn.Text = "[✓] Chế độ Nút bấm"
			checkBtn.BackgroundColor3 = Color3.fromRGB(60, 95, 140)
		else
			checkBtn.Text = "[ ] Chế độ Nút bấm"
			checkBtn.BackgroundColor3 = Color3.fromRGB(40, 43, 52)
		end
		refreshActionButtonText()
	end)

	refreshActionButtonText()
end

buildGui()
