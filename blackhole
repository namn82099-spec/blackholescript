-- LƯU & ĐỌC TỐC ĐỘ (TWEEN_SPEED & DODGE_SPEED)
-- ==========================================
local memorySpeedConfig = {
	tweenSpeed = TWEEN_SPEED,
	dodgeSpeed = DODGE_SPEED,
}

local function canUseFileApi()
	return typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"
end

local function loadSavedSpeeds()
	local loadedT = memorySpeedConfig.tweenSpeed
	local loadedD = memorySpeedConfig.dodgeSpeed

	if canUseFileApi() then
		local okExists, exists = pcall(isfile, SETTINGS_FILE)
		if okExists and exists then
			local okRead, raw = pcall(readfile, SETTINGS_FILE)
			if okRead and typeof(raw) == "string" and #raw > 0 then
				local okDecode, data = pcall(function()
					return HttpService:JSONDecode(raw)
				end)
				if okDecode and typeof(data) == "table" then
					if tonumber(data.tweenSpeed) and tonumber(data.tweenSpeed) > 0 then
						loadedT = tonumber(data.tweenSpeed)
					end
					if tonumber(data.dodgeSpeed) and tonumber(data.dodgeSpeed) > 0 then
						loadedD = tonumber(data.dodgeSpeed)
					end
				end
			end
		end
	end

	TWEEN_SPEED = loadedT
	DODGE_SPEED = loadedD
	memorySpeedConfig.tweenSpeed = TWEEN_SPEED
	memorySpeedConfig.dodgeSpeed = DODGE_SPEED
end

local function saveSpeeds()
	memorySpeedConfig.tweenSpeed = TWEEN_SPEED
	memorySpeedConfig.dodgeSpeed = DODGE_SPEED
	if canUseFileApi() then
		pcall(function()
			local encoded = HttpService:JSONEncode({
				tweenSpeed = TWEEN_SPEED,
				dodgeSpeed = DODGE_SPEED,
			})
			writefile(SETTINGS_FILE, encoded)
		end)
	end
end

loadSavedSpeeds()

-- ==========================================
-- CHỐNG TAG & GỬI CHAT AN TOÀN
-- ==========================================
local function antiTagText(text)
	if typeof(text) ~= "string" then return "" end
	local cleaned = text:gsub("[%$#]", "")
	cleaned = cleaned
		:gsub("tspeed", "t_speed")
		:gsub("dspeed", "d_speed")
		:gsub("cmd_ta", "cmd ta")
		:gsub("cmd_tv", "cmd tv")
		:gsub("reset", "re_set")
		:gsub("platform", "plat_form")
	return cleaned
end

local function sendRawChat(message)
	if isUnloaded or typeof(message) ~= "string" or #message == 0 then return end
	pcall(function()
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			local general = TextChatService:FindFirstChild("TextChannels")
				and (TextChatService.TextChannels:FindFirstChild("RBXGeneral") or TextChatService.TextChannels:GetChildren()[1])
			if general and general:IsA("TextChannel") then
				general:SendAsync(message)
				return
			end
		end
	end)
	pcall(function()
		local chatEvents = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
		local sayMsg = chatEvents and chatEvents:FindFirstChild("SayMessageRequest")
		if sayMsg then sayMsg:FireServer(message, "All") end
	end)
end

local function sendAntiTagChat(rawText)
	sendRawChat(antiTagText(rawText))
end

-- ==========================================
-- TRẠNG THÁI NHÂN VẬT & ANIMATION
-- ==========================================
local function getHrp(char)
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function isAliveChar(char)
	if isUnloaded or not char or not char.Parent then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = getHrp(char)
	return hum and hrp and hum.Parent and hrp.Parent and hum:GetState() ~= Enum.HumanoidStateType.Dead
end

local function zeroCharacterVelocity(char)
	if not char then return end
	for _, obj in ipairs(char:GetDescendants()) do
		if obj:IsA("BasePart") then
			pcall(function()
				obj.AssemblyLinearVelocity = Vector3.zero
				obj.AssemblyAngularVelocity = Vector3.zero
				obj.Velocity = Vector3.zero
				obj.RotVelocity = Vector3.zero
			end)
		end
	end
end

local function clearMovers(hrp)
	if not hrp then return end
	for _, child in ipairs(hrp:GetChildren()) do
		if child.Name == "SkyMoveAlign" or child.Name == "SkyMoveAttachment" or child:IsA("BodyMover") or child:IsA("LinearVelocity") or child:IsA("AngularVelocity") or child:IsA("VectorForce") or child:IsA("AlignPosition") or child:IsA("AlignOrientation") then
			child:Destroy()
		end
	end
end

local function resetAnimateScript(char)
	if not char then return end
	local animScript = char:FindFirstChild("Animate")
	if animScript and animScript:IsA("LocalScript") then
		pcall(function()
			animScript.Disabled = true
			task.defer(function()
				if animScript and animScript.Parent then
					animScript.Disabled = false
				end
			end)
		end)
	end
end

local function restoreCharacterState(char)
	if not char then return end
	local hrp = getHrp(char)
	if hrp and hrp:IsA("BasePart") then
		clearMovers(hrp)
		hrp.Anchored = false
	end

	zeroCharacterVelocity(char)

	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum and hum:GetState() ~= Enum.HumanoidStateType.Dead then
		hum.Sit = false
		hum.PlatformStand = false
		hum.AutoRotate = true
		pcall(function()
			hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
			hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
			hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
			hum:SetStateEnabled(Enum.HumanoidStateType.Running, true)
			hum:SetStateEnabled(Enum.HumanoidStateType.RunningNoPhysics, true)
			hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
			hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
			hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, true)
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
			task.defer(function()
				if hum and hum.Parent and hum:GetState() ~= Enum.HumanoidStateType.Dead then
					hum:ChangeState(Enum.HumanoidStateType.Running)
				end
			end)
		end)
		resetAnimateScript(char)
	end
end

