	actionBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	actionBtn.Font = Enum.Font.GothamBold
	actionBtn.TextSize = 14
	actionBtn.Parent = frame

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 6)
	btnCorner.Parent = actionBtn

	refreshActionButtonText = function()
		if isUnloaded then return end
		if isButtonMode then
			actionBtn.Text = "LÊN PLATFORM (BẤM)"
			actionBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 210)
		else
			if isActive then
				actionBtn.Text = "BẬT"
				actionBtn.BackgroundColor3 = Color3.fromRGB(45, 170, 95)
			else
				actionBtn.Text = "TẮT"
				actionBtn.BackgroundColor3 = Color3.fromRGB(170, 55, 55)
			end
		end
	end

	actionBtn.MouseButton1Click:Connect(function()
		if isUnloaded then return end
		if isButtonMode then
			goUpToPlatform()
		else
			isActive = not isActive
			refreshActionButtonText()
			if isActive then
				respawnTweenPending = false
				goUpToPlatform()
			else
				respawnTweenPending = false
				goBackToOrigin()
			end
		end
	end)

	local checkBtn = Instance.new("TextButton")
	checkBtn.Name = "ModeCheckButton"
	checkBtn.Size = UDim2.new(1, -16, 0, 28)
	checkBtn.Position = UDim2.fromOffset(8, 74)
	checkBtn.BackgroundColor3 = Color3.fromRGB(40, 43, 52)
	checkBtn.Text = "[ ] Chế độ Nút bấm"
	checkBtn.TextColor3 = Color3.fromRGB(225, 225, 225)
	checkBtn.Font = Enum.Font.GothamSemibold
	checkBtn.TextSize = 12
	checkBtn.Parent = frame

	local checkCorner = Instance.new("UICorner")
	checkCorner.CornerRadius = UDim.new(0, 6)
	checkCorner.Parent = checkBtn

	checkBtn.MouseButton1Click:Connect(function()
		if isUnloaded then return end
		isButtonMode = not isButtonMode
		if isButtonMode then
			respawnTweenPending = false
			checkBtn.Text = "[✓] Chế độ Nút bấm"
			checkBtn.BackgroundColor3 = Color3.fromRGB(60, 95, 140)
		else
			checkBtn.Text = "[ ] Chế độ Nút bấm"
			checkBtn.BackgroundColor3 = Color3.fromRGB(40, 43, 52)
		end
		refreshActionButtonText()
	end)

	if role == "owner" then
		local setPlatBtn = Instance.new("TextButton")
		setPlatBtn.Name = "SetPlatformButton"
		setPlatBtn.Size = UDim2.new(1, -16, 0, 28)
		setPlatBtn.Position = UDim2.fromOffset(8, 108)
		setPlatBtn.BackgroundColor3 = Color3.fromRGB(85, 65, 145)
		setPlatBtn.Text = "SET PLATFORM"
		setPlatBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		setPlatBtn.Font = Enum.Font.GothamBold
		setPlatBtn.TextSize = 11
		setPlatBtn.Parent = frame

		local setCorner = Instance.new("UICorner")
		setCorner.CornerRadius = UDim.new(0, 6)
		setCorner.Parent = setPlatBtn

		local feedbackToken = 0
		setPlatformFeedback = function(vec3)
			if isUnloaded then return end
			feedbackToken += 1
			local myFb = feedbackToken
			setPlatBtn.Text = string.format("SET: %d, %d, %d", math.round(vec3.X), math.round(vec3.Y), math.round(vec3.Z))
			setPlatBtn.BackgroundColor3 = Color3.fromRGB(45, 155, 95)
			task.delay(1.5, function()
				if not isUnloaded and feedbackToken == myFb and setPlatBtn and setPlatBtn.Parent then
					setPlatBtn.Text = "SET PLATFORM"
					setPlatBtn.BackgroundColor3 = Color3.fromRGB(85, 65, 145)
				end
			end)
		end

		setPlatBtn.MouseButton1Click:Connect(function()
			setPointOnly()
		end)
	else
		local reset97Btn = Instance.new("TextButton")
		reset97Btn.Name = "AutoReset97Button"
		reset97Btn.Size = UDim2.new(1, -16, 0, 28)
		reset97Btn.Position = UDim2.fromOffset(8, 108)
		reset97Btn.BackgroundColor3 = Color3.fromRGB(40, 43, 52)
		reset97Btn.Text = "[ ] Reset HP<=97 (7s->R->2s)"
		reset97Btn.TextColor3 = Color3.fromRGB(225, 225, 225)
		reset97Btn.Font = Enum.Font.GothamSemibold
		reset97Btn.TextSize = 11
		reset97Btn.Parent = frame

		local resetCorner = Instance.new("UICorner")
		resetCorner.CornerRadius = UDim.new(0, 6)
		resetCorner.Parent = reset97Btn

		reset97Btn.MouseButton1Click:Connect(function()
			if isUnloaded then return end
			isAutoReset97 = not isAutoReset97
			if isAutoReset97 then
				respawnTweenPending = false
				reset97Btn.Text = "[✓] Reset HP<=97 (7s->R->2s)"
				reset97Btn.BackgroundColor3 = Color3.fromRGB(145, 85, 40)
				if LocalPlayer.Character then
					attachHp97Watcher(LocalPlayer.Character)
				end
			else
				autoResetBusy = false
				reset97Btn.Text = "[ ] Reset HP<=97 (7s->R->2s)"
				reset97Btn.BackgroundColor3 = Color3.fromRGB(40, 43, 52)
			end
		end)
	end

	local unloadBtn = Instance.new("TextButton")
	unloadBtn.Name = "UnloadButton"
	unloadBtn.Size = UDim2.new(1, -16, 0, 26)
	unloadBtn.Position = UDim2.fromOffset(8, 144)
	unloadBtn.BackgroundColor3 = Color3.fromRGB(120, 35, 45)
	unloadBtn.Text = "UNLOAD"
	unloadBtn.TextColor3 = Color3.fromRGB(255, 230, 230)
	unloadBtn.Font = Enum.Font.GothamBold
	unloadBtn.TextSize = 11
	unloadBtn.Parent = frame

	local unloadCorner = Instance.new("UICorner")
	unloadCorner.CornerRadius = UDim.new(0, 6)
	unloadCorner.Parent = unloadBtn

	unloadBtn.MouseButton1Click:Connect(function()
		unloadScript()
	end)

	refreshActionButtonText()
end

buildGui()
