-- NOCLIP & FREEZE (KHÔNG DÙNG CFRAME)
-- ==========================================
local function setNoclip(enabled)
	if noclipConn then
		noclipConn:Disconnect()
		noclipConn = nil
	end

	if enabled and not isUnloaded then
		noclipConn = RunService.Stepped:Connect(function()
			if isUnloaded or not LocalPlayer.Character then return end
			for _, obj in ipairs(LocalPlayer.Character:GetDescendants()) do
				if obj:IsA("BasePart") then obj.CanCollide = false end
			end
		end)
	elseif LocalPlayer.Character then
		for _, obj in ipairs(LocalPlayer.Character:GetDescendants()) do
			if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart" then
				obj.CanCollide = true
			end
		end
	end
end

local function stopFreeze()
	if freezeRenderConn then freezeRenderConn:Disconnect(); freezeRenderConn = nil end
	if freezeHeartConn then freezeHeartConn:Disconnect(); freezeHeartConn = nil end
	frozenPos = nil

	local char = LocalPlayer.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.PlatformStand = false
			pcall(function()
				hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
				hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
			end)
		end
		local hrp = getHrp(char)
		if hrp and hrp:IsA("BasePart") then hrp.Anchored = false end
	end
end

local function lockRootInPlace()
	if isUnloaded then return end
	local char = LocalPlayer.Character
	local hrp = getHrp(char)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not frozenPos then return end

	if hum then
		hum.PlatformStand = false
		pcall(function()
			hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
			hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
		end)
	end

	clearMovers(hrp)
	hrp.Anchored = true
	zeroCharacterVelocity(char)

	if (hrp.Position - frozenPos).Magnitude > 0.05 then
		hrp.Position = frozenPos
	end
end

local function startFreezeAtCurrentSpot(hrp, overridePos)
	stopFreeze()
	if isUnloaded or not hrp or not hrp.Parent then return end

	frozenPos = overridePos or hrp.Position
	lockRootInPlace()

	freezeRenderConn = RunService.RenderStepped:Connect(function()
		if isUnloaded or not frozenPos then stopFreeze(); return end
		lockRootInPlace()
	end)

	freezeHeartConn = RunService.Heartbeat:Connect(function()
		if isUnloaded or not frozenPos then stopFreeze(); return end
		lockRootInPlace()
	end)
end

-- ==========================================
-- QUÉT 100 STUD TRÊN ĐẦU (TỪ 400 STUD TRỞ ĐI) & TÌM HƯỚNG NGANG KHÔNG VẬT CẢN
-- ==========================================
local cachedRayParams = nil
local cachedRayChar = nil

local function getRayParams(char)
	if cachedRayParams and cachedRayChar == char then
		return cachedRayParams
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = {}
	if char then table.insert(ignore, char) end
	if skyPlatform and skyPlatform.Parent then table.insert(ignore, skyPlatform) end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character then table.insert(ignore, plr.Character) end
	end
	params.FilterDescendantsInstances = ignore
	cachedRayParams = params
	cachedRayChar = char
	return params
end

local function isBlockingPart(part)
	if not part or not part:IsA("BasePart") then return false end
	if part.Name == PLATFORM_NAME then return false end
	return part.Transparency < 0.98
end

local function rayHitsObstacle(origin, dirVec, char)
	local res = workspace:Raycast(origin, dirVec, getRayParams(char))
	return res and isBlockingPart(res.Instance) or false
end

local function hasOverheadObstacle100(currChar, currRoot)
	local base = currRoot.Position
	local upVec = Vector3.new(0, OVERHEAD_SCAN_STUDS, 0)
	local offsets = {
		Vector3.zero,
		Vector3.new(6, 0, 0),
		Vector3.new(-6, 0, 0),
		Vector3.new(0, 0, 6),
		Vector3.new(0, 0, -6),
	}

	for _, off in ipairs(offsets) do
		if rayHitsObstacle(base + off, upVec, currChar) then
			return true
		end
	end

	return false
end

local function isHorizontalPathClear(originPos, dirUnit, dist, char)
	for _, yOffset in ipairs({ 0, 35, 70, 100 }) do
		local rayOrigin = Vector3.new(originPos.X, originPos.Y + yOffset, originPos.Z)
		if rayHitsObstacle(rayOrigin, dirUnit * dist, char) then
			return false
		end
	end
	return true
end

local function findClearHorizontalDodgePos(currentPos, dist, char)
	local startAngle = math.random() * math.pi * 2
	local steps = 48
	for i = 0, steps - 1 do
		local angle = startAngle + (i / steps) * math.pi * 2
		local dir = Vector3.new(math.cos(angle), 0, math.sin(angle)).Unit
		if isHorizontalPathClear(currentPos, dir, dist, char) then
			return Vector3.new(
				currentPos.X + dir.X * dist,
				currentPos.Y,
				currentPos.Z + dir.Z * dist
			)
		end
	end

	local fallbackDir = Vector3.new(math.cos(startAngle), 0, math.sin(startAngle)).Unit
	return Vector3.new(
		currentPos.X + fallbackDir.X * dist,
		currentPos.Y,
		currentPos.Z + fallbackDir.Z * dist
	)
end

-- ==========================================
-- DI CHUYỂN BẰNG ALIGNPOSITION (KHÔNG DÙNG CFRAME)
-- ==========================================
local function cancelActiveMove()
	moveToken += 1
	activeMoveSequence = false
	local hrp = getHrp(LocalPlayer.Character)
	if hrp then clearMovers(hrp) end
end

local function createMoveAlign(hrp, targetPos, speed)
	clearMovers(hrp)

	local att = Instance.new("Attachment")
	att.Name = "SkyMoveAttachment"
	att.Position = Vector3.zero
	att.Parent = hrp

	local align = Instance.new("AlignPosition")
	align.Name = "SkyMoveAlign"
	align.Mode = Enum.PositionAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.Position = targetPos
	align.MaxForce = 1e6
	align.MaxVelocity = speed
	align.Responsiveness = 65
	align.Parent = hrp

	return align, att
end

local function moveSingleSegment(targetPos, myToken, onStepCheck, customSpeed)
	if isUnloaded or not activeMoveSequence or moveToken ~= myToken then return false, false end
	local char = LocalPlayer.Character
	local hrp = getHrp(char)
	if not isAliveChar(char) or not hrp then return false, false end

	setMovePhysicsLock(char, hrp, true)

	local dist = (hrp.Position - targetPos).Magnitude
	if dist <= 1.2 then
		hrp.Position = targetPos
		zeroCharacterVelocity(char)
		clearMovers(hrp)
		return true, false
	end

	local speed = customSpeed or TWEEN_SPEED
	local align, att = createMoveAlign(hrp, targetPos, speed)

	local lastCheck = 0
	local startClock = os.clock()
	local maxWait = math.max(dist / math.max(speed, 1), 0.1) + 2.5

	while not isUnloaded and activeMoveSequence and (moveToken == myToken) do
		local c = LocalPlayer.Character
		local r = getHrp(c)
		local h = c and c:FindFirstChildOfClass("Humanoid")
		if not c or not c.Parent or not r or not r.Parent or not h or h:GetState() == Enum.HumanoidStateType.Dead then
			clearMovers(r)
			return false, false
		end

		if onStepCheck and (os.clock() - lastCheck) >= 0.03 then
			lastCheck = os.clock()
			if onStepCheck(c, r, targetPos) then
				clearMovers(r)
				zeroCharacterVelocity(c)
				return false, true
			end
		end

		if align.Parent ~= r then
			align, att = createMoveAlign(r, targetPos, speed)
		else
			align.Position = targetPos
		end

		if (r.Position - targetPos).Magnitude <= 1.5 then
			r.Position = targetPos
			zeroCharacterVelocity(c)
			clearMovers(r)
			return true, false
		end

		if (os.clock() - startClock) >= maxWait then
			clearMovers(r)
			return false, false
		end

		RunService.Heartbeat:Wait()
	end

	clearMovers(hrp)
	return false, false
end

local function climbStraightSegment(targetY, myToken)
	while not isUnloaded and activeMoveSequence and (moveToken == myToken) do
		local c = LocalPlayer.Character
		local r = getHrp(c)
		if not c or not r then return false end
		if r.Position.Y >= targetY - 1.5 then return true end

		local goalPos = Vector3.new(r.Position.X, targetY, r.Position.Z)
		if not moveSingleSegment(goalPos, myToken, nil, TWEEN_SPEED) then
			return false
		end
	end
	return false
end

local function climbToSkyWith400Scan(startBaseY, targetY, myToken)
	local stage400Y = startBaseY + STAGE_1_CLIMB_STUDS

	-- 1. Từ 0 đến 400 stud: bay thẳng lên, không quét vật cản
	if targetY > stage400Y then
		while not isUnloaded and activeMoveSequence and (moveToken == myToken) do
			local c = LocalPlayer.Character
			local r = getHrp(c)
			if not c or not r then return false end
			if r.Position.Y >= stage400Y - 1.5 then break end

			local goal400Pos = Vector3.new(r.Position.X, stage400Y, r.Position.Z)
			if not moveSingleSegment(goal400Pos, myToken, nil, TWEEN_SPEED) then
				return false
			end
		end
	else
		return climbStraightSegment(targetY, myToken)
	end

	if isUnloaded or not activeMoveSequence or moveToken ~= myToken then return false end

	-- 2. Từ 400 stud trở đi: quét liên tục 100 stud trên đầu; có vật cản thì tìm hướng ngang thoáng né 450 stud rồi bay lên đủ 700 stud; không có thì cứ bay lên như cũ
	while not isUnloaded and activeMoveSequence and (moveToken == myToken) do
		local c = LocalPlayer.Character
		local r = getHrp(c)
		if not c or not r then return false end
		if r.Position.Y >= targetY - 1.5 then return true end

		local ok, hitObstacle = moveSingleSegment(
			Vector3.new(r.Position.X, targetY, r.Position.Z),
			myToken,
			function(currChar, currRoot)
				return hasOverheadObstacle100(currChar, currRoot)
			end,
			TWEEN_SPEED
		)

		if ok then return true end
		if not hitObstacle then return false end

		local cNow = LocalPlayer.Character
		local rNow = getHrp(cNow)
		if not cNow or not rNow then return false end

		local dodgePos = findClearHorizontalDodgePos(rNow.Position, DODGE_HORIZONTAL_STUDS, cNow)
		if not moveSingleSegment(dodgePos, myToken, nil, DODGE_SPEED) then
			return false
		end

		local full700Y = math.max(targetY, startBaseY + SKY_CLIMB_STUDS)
		if not climbStraightSegment(full700Y, myToken) then
			return false
		end
		return true
	end

	return false
end

local function moveViaSkyToTarget(targetPos, onComplete)
	if isUnloaded then return end
	local char = LocalPlayer.Character
	local hrp = getHrp(char)
	if not isAliveChar(char) or not hrp then return end

	cancelActiveMove()
	stopFreeze()
	setMovePhysicsLock(char, hrp, true)
	setNoclip(true)

	local myToken = moveToken
	activeMoveSequence = true

	task.spawn(function()
		local function cleanupFail()
			if moveToken == myToken then activeMoveSequence = false end
			local curHrp = getHrp(LocalPlayer.Character)
			if curHrp then clearMovers(curHrp) end
			setNoclip(false)
			setMovePhysicsLock(LocalPlayer.Character, curHrp, false)
		end

		local function abortIfDone()
			if isUnloaded or moveToken ~= myToken then
				cleanupFail()
				return true
			end
			return false
		end

		local startPos = hrp.Position
		local skyGoalY = math.max(startPos.Y + SKY_CLIMB_STUDS, targetPos.Y)
		if not climbToSkyWith400Scan(startPos.Y, skyGoalY, myToken) then
			cleanupFail()
			return
		end
		if abortIfDone() then return end

		local curRoot = getHrp(LocalPlayer.Character)
		local climbY = curRoot and curRoot.Position.Y or skyGoalY
		local aboveTargetPos = Vector3.new(targetPos.X, climbY, targetPos.Z)
		if not moveSingleSegment(aboveTargetPos, myToken, nil, TWEEN_SPEED) then
			cleanupFail()
			return
		end
		if abortIfDone() then return end

		if not moveSingleSegment(targetPos, myToken, nil, TWEEN_SPEED) then
			cleanupFail()
			return
		end
		if abortIfDone() then return end

		activeMoveSequence = false
		local finalChar = LocalPlayer.Character
		local finalRoot = getHrp(finalChar)
		if finalChar and finalRoot then
			clearMovers(finalRoot)
			finalRoot.Position = targetPos
			zeroCharacterVelocity(finalChar)
			if onComplete then onComplete(finalChar, finalRoot, targetPos) end
			if not frozenPos then
				setMovePhysicsLock(finalChar, finalRoot, false)
			end
		end
	end)
end

local function getTargetStandPos()
	if customSetPoint then
		return customSetPoint
	end
	local plat = initInitialPlatform()
	local topY = plat and (plat.Position.Y + (plat.Size.Y / 2) + 3.2) or FIXED_PLATFORM_POS.Y
	return Vector3.new(plat and plat.Position.X or FIXED_PLATFORM_POS.X, topY, plat and plat.Position.Z or FIXED_PLATFORM_POS.Z)
end

-- ==========================================
-- KILL FARM (OWNER): BAY NÉ VẬT CẢN -> FREEZE -> SPAM M1 CLIENTSIDE
-- ==========================================
local function stopKillFarm(unfreeze)
	isKillFarm = false
	killFarmThread = nil
	if unfreeze ~= false then
		stopFreeze()
	end
end

local function fireClientM1()
	local mouse = LocalPlayer:GetMouse()
	local x = (mouse and mouse.X and mouse.X > 0) and mouse.X or 500
	local y = (mouse and mouse.Y and mouse.Y > 0) and mouse.Y or 500

	pcall(function()
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
		task.wait(0.015)
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
	end)
	pcall(function()
		if typeof(mouse1click) == "function" then
			mouse1click()
		elseif typeof(mouse1press) == "function" and typeof(mouse1release) == "function" then
			mouse1press()
			task.wait(0.015)
			mouse1release()
		end
	end)
end

local function startKillFarmLoop()
	if killFarmThread then return end
	killFarmThread = task.spawn(function()
		while not isUnloaded and role == "owner" and isKillFarm do
			local c = LocalPlayer.Character
			if isAliveChar(c) then
				fireClientM1()
			end
			task.wait(M1_SPAM_INTERVAL)
		end
		killFarmThread = nil
	end)
end

local function toggleKillFarm(enabled)
	if isUnloaded or role ~= "owner" then return end
	if not enabled then
		stopKillFarm(true)
		return
	end

	local char = LocalPlayer.Character
	local hrp = getHrp(char)
	if not isAliveChar(char) or not hrp then return end

	isKillFarm = true
	respawnMovePending = false
	isActive = false
	if refreshActionButtonText then refreshActionButtonText() end

	moveViaSkyToTarget(getTargetStandPos(), function(finalChar, root, landedPos)
		if isUnloaded or role ~= "owner" or not isKillFarm then
			setNoclip(false)
			return
		end
		startFreezeAtCurrentSpot(root, landedPos)
		zeroCharacterVelocity(finalChar)
		setNoclip(false)
		startKillFarmLoop()
	end)
end

-- ==========================================
-- HÀNH ĐỘNG LÊN ĐIỂM / BAY VỀ VỊ TRÍ CŨ
-- ==========================================
local function goUpToPlatform()
	if isUnloaded then return end
	local char = LocalPlayer.Character
	local hrp = getHrp(char)
	if not isAliveChar(char) or not hrp then return end

	if not savedOriginPos then savedOriginPos = hrp.Position end

	moveViaSkyToTarget(getTargetStandPos(), function(finalChar, root, landedPos)
		if role == "alt" then startFreezeAtCurrentSpot(root, landedPos) end
		zeroCharacterVelocity(finalChar)
		setNoclip(false)
	end)
end

local function goBackToOrigin()
	if isUnloaded then return end
	local char = LocalPlayer.Character
	local hrp = getHrp(char)
	if not isAliveChar(char) or not hrp then return end

	stopFreeze()

	moveViaSkyToTarget(savedOriginPos or hrp.Position, function(finalChar)
		zeroCharacterVelocity(finalChar)
		setNoclip(false)
		savedOriginPos = nil
	end)
end

-- ==========================================
-- AUTO RESET KHI HP <= 97 -> ĐỢI 7S ẤN R -> ĐỢI 2S BAY LÊN PLATFORM SET
-- ==========================================
local function pressKeyR()
	if isUnloaded then return end
	pcall(function()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
		task.wait(0.06)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
	end)
	pcall(function()
		if typeof(keytap) == "function" then
			keytap(0x52)
		elseif typeof(keypress) == "function" and typeof(keyrelease) == "function" then
			keypress(0x52)
			task.wait(0.06)
			keyrelease(0x52)
		end
	end)
end

local function forceResetCharacter(char)
	if not char then return end
	cancelActiveMove()
	stopFreeze()
	setNoclip(false)

	local hum = char:FindFirstChildOfClass("Humanoid")
	pcall(function()
		if hum then
			hum.Health = 0
			hum:ChangeState(Enum.HumanoidStateType.Dead)
		end
	end)
	pcall(function() char:BreakJoints() end)
end

local function triggerAutoReset97Flow(char)
	if isUnloaded or role ~= "alt" or not isAutoReset97 or autoResetBusy then return end
	autoResetBusy = true

	task.spawn(function()
		forceResetCharacter(char)

		task.wait(7)
		if isUnloaded or not isAutoReset97 then autoResetBusy = false; return end
		pressKeyR()

		task.wait(2)
		autoResetBusy = false
		if not isUnloaded and isAutoReset97 then
			respawnMovePending = false
			goUpToPlatform()
		end
	end)
end

local function attachHp97Watcher(char)
	if hpWatchConn then hpWatchConn:Disconnect(); hpWatchConn = nil end
	if isUnloaded or role ~= "alt" or not char then return end

	local hum = char:WaitForChild("Humanoid", 10)
	if isUnloaded or not hum then return end

	local firedForChar = false
	local function checkHp(hp)
		if isUnloaded or firedForChar or not isAutoReset97 or autoResetBusy then return end
		if hp > 0 and hp <= 97 then
			firedForChar = true
			triggerAutoReset97Flow(char)
		end
	end

	checkHp(hum.Health)
	hpWatchConn = hum.HealthChanged:Connect(checkHp)
end

-- ==========================================
-- THEO DÕI CHẾT & RESPAWN
-- ==========================================
local function hookCharacter(char)
	if isUnloaded then return end
	stopFreeze()
	attachHp97Watcher(char)

	local hum = char:WaitForChild("Humanoid", 10)
	if not isUnloaded and hum then
		hum.Died:Connect(function()
			if isUnloaded then return end
			stopKillFarm(false)
			cancelActiveMove()
			stopFreeze()
			setNoclip(false)

			if role == "alt" and (not isAutoReset97) and (not isButtonMode) and isActive and savedOriginPos then
				respawnMovePending = true
			end
		end)
	end
end

if LocalPlayer.Character then hookCharacter(LocalPlayer.Character) end

trackConn(LocalPlayer.CharacterAdded:Connect(function(newChar)
	if isUnloaded then return end
	hookCharacter(newChar)

	if role == "alt" and (not isAutoReset97) and (not isButtonMode) and isActive and respawnMovePending and savedOriginPos then
		respawnMovePending = false
		local hrp = newChar:WaitForChild("HumanoidRootPart", 10)
		local hum = newChar:WaitForChild("Humanoid", 10)
		if not isUnloaded and hrp and hum then
			local elapsed = 0
			while not isUnloaded and hum:GetState() == Enum.HumanoidStateType.Dead and elapsed < 3 do
				elapsed += task.wait(0.05)
			end
			if isUnloaded then return end
			task.wait(0.25)
			if isUnloaded then return end
			moveViaSkyToTarget(savedOriginPos, function(finalChar)
				zeroCharacterVelocity(finalChar)
				setNoclip(false)
				savedOriginPos = nil
			end)
		end
	end
end))

