local PLATFORM_NAME = "SharedSkyPlatform_Client"
local TWEEN_SPEED = 320
local DODGE_SPEED = 180
local DODGE_MARGIN = 24
local LOOK_AHEAD_STUDS = 36
local SCAN_360_SEGMENTS = 16 -- chia vòng 360 độ thành 16 hướng (mỗi hướng 22.5 độ)
local SKY_CLIMB_STUDS = 700
local OBSTACLE_CHECK_START_STUDS = 400
local OBSTACLE_CHECK_RADIUS = 12

