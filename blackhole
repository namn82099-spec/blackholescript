local skyPlatform = nil

local function initInitialPlatform()
	if isUnloaded then return nil end
	if skyPlatform and skyPlatform.Parent then return skyPlatform end

	local existing = workspace:FindFirstChild(PLATFORM_NAME)
	if existing and existing:IsA("BasePart") then
		skyPlatform = existing
		return skyPlatform
	end

	local part = Instance.new("Part")
	part.Name = PLATFORM_NAME
	part.Size = PLATFORM_SIZE
	part.Position = FIXED_PLATFORM_POS
	part.Anchored = true
	part.CanCollide = true
	part.Material = Enum.Material.SmoothPlastic
	part.Color = (role == "owner") and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(255, 170, 0)
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = workspace

	skyPlatform = part
	return part
end

initInitialPlatform()

-- ==========================================
-- ĐỒNG BỘ ĐIỂM SET QUA CHAT (__SKYPLAT_POINT__)
-- ==========================================
local SYNC_PREFIX = "__SKYPLAT_POINT__:"

local function parseSyncMessage(msg)
	if typeof(msg) ~= "string" then return nil end
	local idx = string.find(msg, SYNC_PREFIX, 1, true)
	if not idx then return nil end
	local body = string.sub(msg, idx + #SYNC_PREFIX)
	local x, y, z = string.match(body, "^%s*([%-+%d%.]+)%s*,%s*([%-+%d%.]+)%s*,%s*([%-+%d%.]+)%s*")
	local nx, ny, nz = tonumber(x), tonumber(y), tonumber(z)
	return (nx and ny and nz) and Vector3.new(nx, ny, nz) or nil
end

local function sendSyncChat(vec3)
	if isUnloaded then return end
	local payload = string.format("%s%.2f,%.2f,%.2f", SYNC_PREFIX, vec3.X, vec3.Y, vec3.Z)
	pcall(function()
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			local general = TextChatService:FindFirstChild("TextChannels")
				and (TextChatService.TextChannels:FindFirstChild("RBXGeneral") or TextChatService.TextChannels:GetChildren()[1])
			if general and general:IsA("TextChannel") then
				general:SendAsync(payload)
				return
			end
		end
	end)
	pcall(function()
		local chatEvents = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
		local sayMsg = chatEvents and chatEvents:FindFirstChild("SayMessageRequest")
		if sayMsg then sayMsg:FireServer(payload, "All") end
	end)
end

if role == "alt" then
	pcall(function()
		trackConn(TextChatService.MessageReceived:Connect(function(msg)
			if isUnloaded then return end
			local sender = msg.TextSource and Players:GetPlayerByUserId(msg.TextSource.UserId)
			if sender and sender.Name == OwnerName then
				local pos = parseSyncMessage(msg.Text)
				if pos then customSetPoint = pos end
			end
		end))
	end)

	trackConn(Players.PlayerChatted:Connect(function(_, sender, message)
		if isUnloaded then return end
		if sender and sender.Name == OwnerName then
			local pos = parseSyncMessage(message)
			if pos then customSetPoint = pos end
		end
	end))
end

local function setPointOnly()
	if isUnloaded or role ~= "owner" then return end
	local char = LocalPlayer.Character
	if not isAliveChar(char) then return end
	customSetPoint = getHrp(char).Position
	if setPlatformFeedback then setPlatformFeedback(customSetPoint) end
	sendSyncChat(customSetPoint)
end

-- ==========================================
-- NOCLIP & FREEZE
-- ==========================================
local function setNoclip(enabled)
	if noclipConn then
		noclipConn:Disconnect()
		noclipConn = nil
	end

	if enabled and not isUnloaded then
		noclipConn = RunService.Stepped:Connect(function()
			if isUnloaded or not LocalPlayer.Character then return end
			for _, obj in ipairs(LocalPlayer.Character:GetDescendants()) do
				if obj:IsA("BasePart") then obj.CanCollide = false end
			end
		end)
	elseif LocalPlayer.Character then
		for _, obj in ipairs(LocalPlayer.Character:GetDescendants()) do
			if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart" then
				obj.CanCollide = true
			end
		end
	end
end

local function stopFreeze()
	if freezeRenderConn then freezeRenderConn:Disconnect(); freezeRenderConn = nil end
	if freezeHeartConn then freezeHeartConn:Disconnect(); freezeHeartConn = nil end
	frozenCFrame = nil

	local char = LocalPlayer.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.PlatformStand = false
			pcall(function()
				hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
				hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
			end)
		end
		local hrp = getHrp(char)
		if hrp and hrp:IsA("BasePart") then hrp.Anchored = false end
	end
end

local function lockRootInPlace()
	if isUnloaded then return end
	local char = LocalPlayer.Character
	local hrp = getHrp(char)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not frozenCFrame then return end

	if hum then
		hum.PlatformStand = false
		pcall(function()
			hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
			hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
		end)
	end

	for _, child in ipairs(hrp:GetChildren()) do
		if child:IsA("BodyMover") or child:IsA("LinearVelocity") or child:IsA("AngularVelocity") or child:IsA("VectorForce") then
			child:Destroy()
		end
	end

	hrp.Anchored = true
	zeroCharacterVelocity(char)

	if (hrp.CFrame.Position - frozenCFrame.Position).Magnitude > 0.001 or hrp.CFrame ~= frozenCFrame then
		hrp.CFrame = frozenCFrame
	end
end

local function startFreezeAtCurrentSpot(hrp, overrideCFrame)
	stopFreeze()
	if isUnloaded or not hrp or not hrp.Parent then return end

	frozenCFrame = overrideCFrame or hrp.CFrame
	lockRootInPlace()

	freezeRenderConn = RunService.RenderStepped:Connect(function()
		if isUnloaded or not frozenCFrame then stopFreeze(); return end
		lockRootInPlace()
	end)

	freezeHeartConn = RunService.Heartbeat:Connect(function()
		if isUnloaded or not frozenCFrame then stopFreeze(); return end
		lockRootInPlace()
	end)
end

-- ==========================================
-- QUÉT 360 TRÁI-PHẢI-TRƯỚC-SAU & TRÊN-DƯỚI + TÌM ĐIỂM NÉ
-- ==========================================
local AHEAD_FRACTIONS = { 0.25, 0.5, 0.75, 1.0 }
local PITCH_OFFSETS = { 0, 0.45, -0.45 } -- ngang, hơi lên, hơi xuống

local function buildDirs360(segments)
	local dirs = {}
	local step = (math.pi * 2) / math.max(segments, 8)
	for i = 0, segments - 1 do
		local yaw = i * step
		local hDir = Vector3.new(math.cos(yaw), 0, math.sin(yaw))
		for _, pitch in ipairs(PITCH_OFFSETS) do
			local cosP = math.cos(pitch)
			local v = Vector3.new(hDir.X * cosP, math.sin(pitch), hDir.Z * cosP)
			table.insert(dirs, v.Unit)
		end
	end
	table.insert(dirs, Vector3.new(0, 1, 0))
	table.insert(dirs, Vector3.new(0, -1, 0))
	return dirs
end

local DIRS_360 = buildDirs360(SCAN_360_SEGMENTS)

local function buildObstacleParams(char)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = {}
	if char then table.insert(ignore, char) end
	if skyPlatform and skyPlatform.Parent then table.insert(ignore, skyPlatform) end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character then table.insert(ignore, plr.Character) end
	end
	params.FilterDescendantsInstances = ignore
	return params
end

local function getBlockingPartAt(pos, radius, char)
	local boxSize = Vector3.new(radius * 2, radius * 2, radius * 2)
	local parts = workspace:GetPartBoundsInBox(CFrame.new(pos), boxSize, buildObstacleParams(char))
	for _, p in ipairs(parts) do
		if p:IsA("BasePart") and p.CanCollide and p.Transparency < 0.95 then
			return p
		end
	end
	return nil
end

local function hasObstacleAt(pos, radius, char)
	return getBlockingPartAt(pos, radius, char) ~= nil
end

local function getAheadObstacle360(currentPos, goalPos, radius, char)
	if hasObstacleAt(currentPos, radius, char) then
		return currentPos, getBlockingPartAt(currentPos, radius, char)
	end

	local delta = goalPos - currentPos
	local dist = delta.Magnitude
	if dist <= 0.1 then return nil, nil end

	local mainDir = delta.Unit
	local probeDist = math.min(dist, LOOK_AHEAD_STUDS)

	-- Ưu tiên quét hướng đi chính trước, sau đó quét 360 quanh điểm dò
	for _, frac in ipairs(AHEAD_FRACTIONS) do
		local centerProbe = currentPos + mainDir * (probeDist * frac)
		local directBlocker = getBlockingPartAt(centerProbe, radius, char)
		if directBlocker then
			return centerProbe, directBlocker
		end

		local ringRadius = radius * 0.85
		for _, d in ipairs(DIRS_360) do
			local ringPos = centerProbe + d * ringRadius
			local blocker = getBlockingPartAt(ringPos, radius, char)
			if blocker then
				return ringPos, blocker
			end
		end
	end

	return nil, nil
end

local function findClearDodgePos360(currentPos, goalPos, blocker, radius, char)
	local delta = goalPos - currentPos
	local forward = (delta.Magnitude > 0.1) and delta.Unit or Vector3.new(0, 0, -1)
	local halfSpan = blocker and (math.max(blocker.Size.X, blocker.Size.Y, blocker.Size.Z) * 0.5) or 0
	local baseDist = halfSpan + DODGE_MARGIN

	-- Sắp xếp các hướng 360 theo độ vuông góc với hướng tới đích để bẻ ngang/chéo dứt khoát
	local sortedDirs = table.clone(DIRS_360)
	table.sort(sortedDirs, function(a, b)
		local perpA = 1 - math.abs(a:Dot(forward))
		local perpB = 1 - math.abs(b:Dot(forward))
		return perpA > perpB
	end)

	for _, extra in ipairs({ 0, 18, 36, 56 }) do
		local d = baseDist + extra
		for _, dir in ipairs(sortedDirs) do
			local cand = Vector3.new(currentPos.X + dir.X * d, currentPos.Y, currentPos.Z + dir.Z * d)
			if not hasObstacleAt(cand, radius + 3, char) then
				return cand
			end
		end
	end

	local horiz = Vector3.new(forward.X, 0, forward.Z)
	local fHoriz = (horiz.Magnitude > 0.05) and horiz.Unit or Vector3.new(0, 0, -1)
	local right = Vector3.new(-fHoriz.Z, 0, fHoriz.X)
	return Vector3.new(currentPos.X + right.X * (baseDist + 24), currentPos.Y, currentPos.Z + right.Z * (baseDist + 24))
end

-- ==========================================
-- TWEEN CÓ TỐC ĐỘ NÉ RIÊNG & KIỂM TRA MỖI FRAME
-- ==========================================
local function cancelActiveTween()
	tweenToken += 1
	activeTweenSequence = false
	if currentTween then
		currentTween:Cancel()
		currentTween = nil
	end
end

local function tweenSingleSegment(targetCFrame, myToken, onStepCheck, customSpeed)
	if isUnloaded then return false, false end
	local char = LocalPlayer.Character
	local hrp = getHrp(char)
	if not isAliveChar(char) or not hrp then return false, false end

	if currentTween then
		currentTween:Cancel()
		currentTween = nil
	end

	local distance = (hrp.Position - targetCFrame.Position).Magnitude
	if distance <= 0.25 then
		hrp.CFrame = targetCFrame
		return true, false, nil
	end

	local completed, cancelled = false, false
	local tween = TweenService:Create(
		hrp,
		TweenInfo.new(math.max(distance / (customSpeed or TWEEN_SPEED), 0.02), Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
		{ CFrame = targetCFrame }
	)
	currentTween = tween

	tween.Completed:Connect(function(state)
		if currentTween == tween then currentTween = nil end
		if state == Enum.PlaybackState.Completed then completed = true else cancelled = true end
	end)

	tween:Play()

	while not isUnloaded and not completed and not cancelled and activeTweenSequence and (tweenToken == myToken) do
		local c = LocalPlayer.Character
		local r = getHrp(c)
		local h = c and c:FindFirstChildOfClass("Humanoid")
		if not c or not c.Parent or not r or not r.Parent or not h or h:GetState() == Enum.HumanoidStateType.Dead then
			tween:Cancel()
			return false, false
		end

		if onStepCheck then
			local dodgePos = onStepCheck(c, r, targetCFrame.Position)
			if dodgePos then
				tween:Cancel()
				return false, true, dodgePos
			end
		end

		RunService.Heartbeat:Wait()
	end

	if isUnloaded then
		tween:Cancel()
		return false, false
	end

	return completed and activeTweenSequence and (tweenToken == myToken), false, nil
end

local function moveSmoothlyWithDodge(goalCFrame, startBaseY, allowClimbCheck, myToken)
	local dodgeAttempts = 0
	while not isUnloaded and activeTweenSequence and (tweenToken == myToken) and dodgeAttempts < 24 do
		local c = LocalPlayer.Character
		local r = getHrp(c)
		if not c or not r then return false end
		if (r.Position - goalCFrame.Position).Magnitude <= 1.2 then return true end

		local ok, shouldDodge, dodgePos = tweenSingleSegment(goalCFrame, myToken, function(currChar, currRoot, segGoal)
			if allowClimbCheck and (currRoot.Position.Y - startBaseY) < OBSTACLE_CHECK_START_STUDS then
				return nil
			end
			local _, blocker = getAheadObstacle360(currRoot.Position, segGoal, OBSTACLE_CHECK_RADIUS, currChar)
			if blocker then
				return findClearDodgePos360(currRoot.Position, segGoal, blocker, OBSTACLE_CHECK_RADIUS, currChar)
			end
			return nil
		end, TWEEN_SPEED)

		if ok then return true end
		if not (shouldDodge and dodgePos) then return false end

		dodgeAttempts += 1
		local c2 = LocalPlayer.Character
		local r2 = getHrp(c2)
		if not c2 or not r2 then return false end

		local safeDodgePos = dodgePos
		local blocker2 = getBlockingPartAt(safeDodgePos, OBSTACLE_CHECK_RADIUS, c2)
		if blocker2 then
			safeDodgePos = findClearDodgePos360(r2.Position, goalCFrame.Position, blocker2, OBSTACLE_CHECK_RADIUS, c2)
		end

		local sideCF = CFrame.new(safeDodgePos.X, r2.Position.Y, safeDodgePos.Z) * goalCFrame.Rotation
		local sideOk = tweenSingleSegment(sideCF, myToken, function(currChar, currRoot, segGoal)
			local _, blocker = getAheadObstacle360(currRoot.Position, segGoal, OBSTACLE_CHECK_RADIUS, currChar)
			if blocker then
				return findClearDodgePos360(currRoot.Position, segGoal, blocker, OBSTACLE_CHECK_RADIUS, currChar)
			end
			return nil
		end, DODGE_SPEED)

		if not sideOk then return false end
	end

	return false
end

local function climbStraightToHeight(targetY, rotationCF, startBaseY, myToken)
	while not isUnloaded and activeTweenSequence and (tweenToken == myToken) do
		local c = LocalPlayer.Character
		local r = getHrp(c)
		if not c or not r then return false end
		if r.Position.Y >= targetY - 0.5 then return true end

		local goalCF = CFrame.new(r.Position.X, targetY, r.Position.Z) * rotationCF
		if not moveSmoothlyWithDodge(goalCF, startBaseY, true, myToken) then return false end
	end
	return false
end

local function tweenViaSkyToTarget(targetCFrame, onComplete)
	if isUnloaded then return end
	local char = LocalPlayer.Character
	local hrp = getHrp(char)
	if not isAliveChar(char) or not hrp then return end

	cancelActiveTween()
	stopFreeze()
	local myToken = tweenToken
	activeTweenSequence = true

	task.spawn(function()
		local function abortIfDone()
			if isUnloaded or tweenToken ~= myToken then
				if tweenToken == myToken then activeTweenSequence = false end
				return true
			end
			return false
		end

		local startPos = hrp.Position
		if not climbStraightToHeight(startPos.Y + SKY_CLIMB_STUDS, targetCFrame.Rotation, startPos.Y, myToken) then
			if tweenToken == myToken then activeTweenSequence = false end
			return
		end
		if abortIfDone() then return end

		local curRoot = getHrp(LocalPlayer.Character)
		local climbY = curRoot and curRoot.Position.Y or (startPos.Y + SKY_CLIMB_STUDS)
		local aboveTargetCF = CFrame.new(targetCFrame.Position.X, climbY, targetCFrame.Position.Z) * targetCFrame.Rotation
		if not moveSmoothlyWithDodge(aboveTargetCF, startPos.Y, false, myToken) then
			if tweenToken == myToken then activeTweenSequence = false end
			return
		end
		if abortIfDone() then return end

		setNoclip(true)
		local ok3 = tweenSingleSegment(targetCFrame, myToken, nil, TWEEN_SPEED)
		if not ok3 then
			setNoclip(false)
			if tweenToken == myToken then activeTweenSequence = false end
			return
		end
		if abortIfDone() then return end

		activeTweenSequence = false
		local finalChar = LocalPlayer.Character
		local finalRoot = getHrp(finalChar)
		if finalChar and finalRoot then
			zeroCharacterVelocity(finalChar)
			finalRoot.CFrame = targetCFrame
			if onComplete then onComplete(finalChar, finalRoot, targetCFrame) end
		end
	end)
end

local function getTargetStandCFrame()
	if customSetPoint then
		return CFrame.new(customSetPoint.X, customSetPoint.Y, customSetPoint.Z)
	end
	local plat = initInitialPlatform()
	local topY = plat and (plat.Position.Y + (plat.Size.Y / 2) + 3.2) or FIXED_PLATFORM_POS.Y
	return CFrame.new(plat and plat.Position.X or FIXED_PLATFORM_POS.X, topY, plat and plat.Position.Z or FIXED_PLATFORM_POS.Z)
end

-- ==========================================
-- HÀNH ĐỘNG LÊN ĐIỂM / TWEEN VỀ VỊ TRÍ CŨ
-- ==========================================
local function goUpToPlatform()
	if isUnloaded then return end
	local char = LocalPlayer.Character
	local hrp = getHrp(char)
	if not isAliveChar(char) or not hrp then return end

	if not savedOriginCFrame then savedOriginCFrame = hrp.CFrame end
	setNoclip(true)

	tweenViaSkyToTarget(getTargetStandCFrame(), function(finalChar, root, landedCF)
		if role == "alt" then startFreezeAtCurrentSpot(root, landedCF) end
		zeroCharacterVelocity(finalChar)
		setNoclip(false)
	end)
end

local function goBackToOrigin()
	if isUnloaded then return end
	local char = LocalPlayer.Character
	local hrp = getHrp(char)
	if not isAliveChar(char) or not hrp then return end

	stopFreeze()
	setNoclip(true)

	tweenViaSkyToTarget(savedOriginCFrame or hrp.CFrame, function(finalChar)
		zeroCharacterVelocity(finalChar)
		setNoclip(false)
		savedOriginCFrame = nil
	end)
end

-- ==========================================
-- AUTO RESET KHI HP <= 97 -> ĐỢI 7S ẤN R -> ĐỢI 2S TWEEN LÊN PLATFORM SET
-- ==========================================
local function pressKeyR()
	if isUnloaded then return end
	pcall(function()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
		task.wait(0.06)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
	end)
	pcall(function()
		if typeof(keytap) == "function" then
			keytap(0x52)
		elseif typeof(keypress) == "function" and typeof(keyrelease) == "function" then
			keypress(0x52)
			task.wait(0.06)
			keyrelease(0x52)
		end
	end)
end

local function forceResetCharacter(char)
	if not char then return end
	cancelActiveTween()
	stopFreeze()
	setNoclip(false)

	local hum = char:FindFirstChildOfClass("Humanoid")
	pcall(function()
		if hum then
			hum.Health = 0
			hum:ChangeState(Enum.HumanoidStateType.Dead)
		end
	end)
	pcall(function() char:BreakJoints() end)
end

local function triggerAutoReset97Flow(char)
	if isUnloaded or role ~= "alt" or not isAutoReset97 or autoResetBusy then return end
	autoResetBusy = true

	task.spawn(function()
		forceResetCharacter(char)

		task.wait(7)
		if isUnloaded or not isAutoReset97 then autoResetBusy = false; return end
		pressKeyR()

		task.wait(2)
		autoResetBusy = false
		if not isUnloaded and isAutoReset97 then
			respawnTweenPending = false
			goUpToPlatform()
		end
	end)
end

local function attachHp97Watcher(char)
	if hpWatchConn then hpWatchConn:Disconnect(); hpWatchConn = nil end
	if isUnloaded or role ~= "alt" or not char then return end

	local hum = char:WaitForChild("Humanoid", 10)
	if isUnloaded or not hum then return end

	local firedForChar = false
	local function checkHp(hp)
		if isUnloaded or firedForChar or not isAutoReset97 or autoResetBusy then return end
		if hp > 0 and hp <= 97 then
			firedForChar = true
			triggerAutoReset97Flow(char)
		end
	end

	checkHp(hum.Health)
	hpWatchConn = hum.HealthChanged:Connect(checkHp)
end

-- ==========================================
-- THEO DÕI CHẾT & RESPAWN
-- ==========================================
local function hookCharacter(char)
	if isUnloaded then return end
	stopFreeze()
	attachHp97Watcher(char)

	local hum = char:WaitForChild("Humanoid", 10)
	if not isUnloaded and hum then
		hum.Died:Connect(function()
			if isUnloaded then return end
			cancelActiveTween()
			stopFreeze()
			setNoclip(false)

			if role == "alt" and (not isAutoReset97) and (not isButtonMode) and isActive and savedOriginCFrame then
				respawnTweenPending = true
			end
		end)
	end
end

if LocalPlayer.Character then hookCharacter(LocalPlayer.Character) end

trackConn(LocalPlayer.CharacterAdded:Connect(function(newChar)
	if isUnloaded then return end
	hookCharacter(newChar)

	if role == "alt" and (not isAutoReset97) and (not isButtonMode) and isActive and respawnTweenPending and savedOriginCFrame then
		respawnTweenPending = false
		local hrp = newChar:WaitForChild("HumanoidRootPart", 10)
		local hum = newChar:WaitForChild("Humanoid", 10)
		if not isUnloaded and hrp and hum then
			local elapsed = 0
			while not isUnloaded and hum:GetState() == Enum.HumanoidStateType.Dead and elapsed < 3 do
				elapsed += task.wait(0.05)
			end
			if isUnloaded then return end
			task.wait(0.25)
			if isUnloaded then return end
			setNoclip(true)
			tweenViaSkyToTarget(savedOriginCFrame, function(finalChar)
				zeroCharacterVelocity(finalChar)
				setNoclip(false)
				savedOriginCFrame = nil
			end)
		end
	end
end))

-- ==========================================
-- UNLOAD TOÀN BỘ SCRIPT, PLATFORM, GUI
-- ==========================================
local function unloadScript()
	if isUnloaded then return end
	isUnloaded = true
	isActive = false
	isAutoReset97 = false
	autoResetBusy = false
	respawnTweenPending = false

	cancelActiveTween()
	stopFreeze()
	setNoclip(false)

	if hpWatchConn then hpWatchConn:Disconnect(); hpWatchConn = nil end
	for _, conn in ipairs(connections) do pcall(function() conn:Disconnect() end) end
	table.clear(connections)

	if skyPlatform and skyPlatform.Parent then pcall(function() skyPlatform:Destroy() end) end
	skyPlatform = nil

	local existingPlat = workspace:FindFirstChild(PLATFORM_NAME)
	if existingPlat then pcall(function() existingPlat:Destroy() end) end

	if activeGui and activeGui.Parent then pcall(function() activeGui:Destroy() end) end
	activeGui = nil

	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
	local existingGui = playerGui and playerGui:FindFirstChild("SkyPlatformControlGui")
	if existingGui then pcall(function() existingGui:Destroy() end) end

	customSetPoint, savedOriginCFrame, refreshActionButtonText, setPlatformFeedback = nil, nil, nil, nil
end

-- ==========================================
-- TẠO GUI
