local skyPlatform = nil

local function initInitialPlatform()
	if isUnloaded then return nil end
	if skyPlatform and skyPlatform.Parent then
		return skyPlatform
	end

	local existing = workspace:FindFirstChild(PLATFORM_NAME)
	if existing and existing:IsA("BasePart") then
		skyPlatform = existing
		return skyPlatform
	end

	local part = Instance.new("Part")
	part.Name = PLATFORM_NAME
	part.Size = PLATFORM_SIZE
	part.Position = FIXED_PLATFORM_POS
	part.Anchored = true
	part.CanCollide = true
	part.Material = Enum.Material.SmoothPlastic
	part.Color = (role == "owner") and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(255, 170, 0)
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = workspace

	skyPlatform = part
	return part
end

initInitialPlatform()

-- ==========================================
-- ĐỒNG BỘ ĐIỂM SET QUA CHAT (__SKYPLAT_POINT__)
-- ==========================================
local SYNC_PREFIX = "__SKYPLAT_POINT__:"

local function parseSyncMessage(msg)
	if typeof(msg) ~= "string" then return nil end
	local idx = string.find(msg, SYNC_PREFIX, 1, true)
	if not idx then return nil end
	local body = string.sub(msg, idx + #SYNC_PREFIX)
	local x, y, z = string.match(body, "^%s*([%-+%d%.]+)%s*,%s*([%-+%d%.]+)%s*,%s*([%-+%d%.]+)%s*")
	local nx, ny, nz = tonumber(x), tonumber(y), tonumber(z)
	if nx and ny and nz then
		return Vector3.new(nx, ny, nz)
	end
	return nil
end

local function sendSyncChat(vec3)
	if isUnloaded then return end
	local payload = string.format("%s%.2f,%.2f,%.2f", SYNC_PREFIX, vec3.X, vec3.Y, vec3.Z)
	pcall(function()
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			local general = TextChatService:FindFirstChild("TextChannels")
				and (TextChatService.TextChannels:FindFirstChild("RBXGeneral") or TextChatService.TextChannels:GetChildren()[1])
			if general and general:IsA("TextChannel") then
				general:SendAsync(payload)
				return
			end
		end
	end)
	pcall(function()
		local chatEvents = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
		local sayMsg = chatEvents and chatEvents:FindFirstChild("SayMessageRequest")
		if sayMsg then
			sayMsg:FireServer(payload, "All")
		end
	end)
end

if role == "alt" then
	pcall(function()
		trackConn(TextChatService.MessageReceived:Connect(function(textChatMessage)
			if isUnloaded then return end
			local sender = textChatMessage.TextSource and Players:GetPlayerByUserId(textChatMessage.TextSource.UserId)
			if sender and sender.Name == OwnerName then
				local pos = parseSyncMessage(textChatMessage.Text)
				if pos then
					customSetPoint = pos
				end
			end
		end))
	end)

	trackConn(Players.PlayerChatted:Connect(function(_, sender, message)
		if isUnloaded then return end
		if sender and sender.Name == OwnerName then
			local pos = parseSyncMessage(message)
			if pos then
				customSetPoint = pos
			end
		end
	end))
end

local function setPointOnly()
	if isUnloaded or role ~= "owner" then return end
	local char = LocalPlayer.Character
	if not isAliveChar(char) then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")

	customSetPoint = hrp.Position
	if setPlatformFeedback then
		setPlatformFeedback(customSetPoint)
	end

	sendSyncChat(customSetPoint)
end

-- ==========================================
-- NOCLIP & FREEZE
-- ==========================================
local function setNoclip(enabled)
	if noclipConn then
		noclipConn:Disconnect()
		noclipConn = nil
	end

	if enabled and not isUnloaded then
		noclipConn = RunService.Stepped:Connect(function()
			if isUnloaded then return end
			local char = LocalPlayer.Character
			if not char then return end
			for _, obj in ipairs(char:GetDescendants()) do
				if obj:IsA("BasePart") then
					obj.CanCollide = false
				end
			end
		end)
	else
		local char = LocalPlayer.Character
		if not char then return end
		for _, obj in ipairs(char:GetDescendants()) do
			if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart" then
				obj.CanCollide = true
			end
		end
	end
end

local function stopFreeze()
	if freezeRenderConn then
		freezeRenderConn:Disconnect()
		freezeRenderConn = nil
	end
	if freezeHeartConn then
		freezeHeartConn:Disconnect()
		freezeHeartConn = nil
	end
	frozenCFrame = nil

	local char = LocalPlayer.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.PlatformStand = false
			pcall(function()
				hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
				hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
			end)
		end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if hrp and hrp:IsA("BasePart") then
			hrp.Anchored = false
		end
	end
end

local function lockRootInPlace()
	if isUnloaded then return end
	local char = LocalPlayer.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not frozenCFrame then return end

	if hum then
		hum.PlatformStand = false
		pcall(function()
			hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
			hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
		end)
	end

	for _, child in ipairs(hrp:GetChildren()) do
		if child:IsA("BodyMover") or child:IsA("LinearVelocity") or child:IsA("AngularVelocity") or child:IsA("VectorForce") then
			child:Destroy()
		end
	end

	hrp.Anchored = true
	zeroCharacterVelocity(char)

	if (hrp.CFrame.Position - frozenCFrame.Position).Magnitude > 0.001 or hrp.CFrame ~= frozenCFrame then
		hrp.CFrame = frozenCFrame
	end
end

local function startFreezeAtCurrentSpot(hrp, overrideCFrame)
	stopFreeze()
	if isUnloaded or not hrp or not hrp.Parent then return end

	frozenCFrame = overrideCFrame or hrp.CFrame
	lockRootInPlace()

	freezeRenderConn = RunService.RenderStepped:Connect(function()
		if isUnloaded or not frozenCFrame then
			stopFreeze()
			return
		end
		lockRootInPlace()
	end)

	freezeHeartConn = RunService.Heartbeat:Connect(function()
		if isUnloaded or not frozenCFrame then
			stopFreeze()
			return
		end
		lockRootInPlace()
	end)
end

-- ==========================================
-- KIỂM TRA VẬT CẢN & TÌM ĐIỂM NÉ
-- ==========================================
local function buildObstacleParams(char)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = {}
	if char then
		table.insert(ignore, char)
	end
	if skyPlatform and skyPlatform.Parent then
		table.insert(ignore, skyPlatform)
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character then
			table.insert(ignore, plr.Character)
		end
	end
	params.FilterDescendantsInstances = ignore
	return params
end

local function getBlockingPartAround(pos, radius, char)
	local params = buildObstacleParams(char)
	local boxSize = Vector3.new(radius * 2, radius * 2, radius * 2)
	local parts = workspace:GetPartBoundsInBox(CFrame.new(pos), boxSize, params)
	for _, p in ipairs(parts) do
		if p:IsA("BasePart") and p.CanCollide and p.Transparency < 0.95 then
			return p
		end
	end
	return nil
end

local function hasObstacleAround(pos, radius, char)
	return getBlockingPartAround(pos, radius, char) ~= nil
end

local function findClearHorizontalPosition(currentPos, radius, char)
	local blocker = getBlockingPartAround(currentPos, radius, char)
	local anchor = blocker and blocker.Position or currentPos
	local halfSpan = blocker and math.max(blocker.Size.X, blocker.Size.Z) * 0.5 or 0

	local directions = {
		Vector3.new(1, 0, 0),
		Vector3.new(-1, 0, 0),
		Vector3.new(0, 0, 1),
		Vector3.new(0, 0, -1),
		Vector3.new(1, 0, 1).Unit,
		Vector3.new(-1, 0, 1).Unit,
		Vector3.new(1, 0, -1).Unit,
		Vector3.new(-1, 0, -1).Unit,
	}

	local extraSteps = { halfSpan + 14, halfSpan + 24, halfSpan + 38, halfSpan + 55 }
	for _, dist in ipairs(extraSteps) do
		for _, dir in ipairs(directions) do
			local candidate = anchor + (dir * dist)
			candidate = Vector3.new(candidate.X, currentPos.Y, candidate.Z)
			if not hasObstacleAround(candidate, radius, char) then
				return candidate
			end
		end
	end

	return currentPos + Vector3.new(halfSpan + 25, 0, 0)
end

-- ==========================================
-- TWEEN 3 CHẶNG
-- ==========================================
local function cancelActiveTween()
	tweenToken += 1
	activeTweenSequence = false
	if currentTween then
		currentTween:Cancel()
		currentTween = nil
	end
end

local function tweenSingleSegment(targetCFrame, myToken, onStepCheck)
	if isUnloaded then return false, false end
	local char = LocalPlayer.Character
	if not isAliveChar(char) then return false, false end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return false, false end

	if currentTween then
		currentTween:Cancel()
		currentTween = nil
	end

	local distance = (hrp.Position - targetCFrame.Position).Magnitude
	local duration = math.max(distance / TWEEN_SPEED, 0.03)

	local completed = false
	local cancelled = false
	local needDodgePos = nil

	local info = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
	local tween = TweenService:Create(hrp, info, { CFrame = targetCFrame })
	currentTween = tween

	tween.Completed:Connect(function(state)
		if currentTween == tween then
			currentTween = nil
		end
		if state == Enum.PlaybackState.Completed then
			completed = true
		else
			cancelled = true
		end
	end)

	tween:Play()

	while not isUnloaded and not completed and not cancelled and activeTweenSequence and (tweenToken == myToken) do
		local c = LocalPlayer.Character
		local r = c and c:FindFirstChild("HumanoidRootPart")
		if not c or not c.Parent or not r or not r.Parent then
			tween:Cancel()
			return false, false
		end
		local h = c:FindFirstChildOfClass("Humanoid")
		if not h or h:GetState() == Enum.HumanoidStateType.Dead then
			tween:Cancel()
			return false, false
		end

		if onStepCheck then
			local dodgePos = onStepCheck(c, r)
			if dodgePos then
				needDodgePos = dodgePos
				tween:Cancel()
				return false, true, needDodgePos
			end
		end

		task.wait()
	end

	if isUnloaded then
		tween:Cancel()
		return false, false
	end

	return completed and activeTweenSequence and (tweenToken == myToken), false, nil
end

local function climbStraightToHeight(targetY, rotationCF, startBaseY, myToken)
	while not isUnloaded and activeTweenSequence and (tweenToken == myToken) do
		local c = LocalPlayer.Character
		local r = c and c:FindFirstChild("HumanoidRootPart")
		if not c or not r then return false end

		local curPos = r.Position
		if curPos.Y >= targetY - 0.5 then
			return true
		end

		local goalCF = CFrame.new(curPos.X, targetY, curPos.Z) * rotationCF
		local checkedThisClimb = false

		local ok, shouldDodge, dodgePos = tweenSingleSegment(goalCF, myToken, function(currChar, currRoot)
			local climbedStuds = currRoot.Position.Y - startBaseY
			if climbedStuds >= OBSTACLE_CHECK_START_STUDS and not checkedThisClimb then
				checkedThisClimb = true
				if hasObstacleAround(currRoot.Position, OBSTACLE_CHECK_RADIUS, currChar) then
					return findClearHorizontalPosition(currRoot.Position, OBSTACLE_CHECK_RADIUS, currChar)
				end
			end
			return nil
		end)

		if ok then
			return true
		end

		if shouldDodge and dodgePos then
			local c2 = LocalPlayer.Character
			local r2 = c2 and c2:FindFirstChild("HumanoidRootPart")
			if not c2 or not r2 then return false end
			local sideCF = CFrame.new(dodgePos.X, r2.Position.Y, dodgePos.Z) * rotationCF
			local sideOk = tweenSingleSegment(sideCF, myToken, nil)
			if not sideOk then
				return false
			end
		else
			return false
		end
	end

	return false
end

local function tweenViaSkyToTarget(targetCFrame, onComplete)
	if isUnloaded then return end
	local char = LocalPlayer.Character
	if not isAliveChar(char) then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	cancelActiveTween()
	stopFreeze()
	local myToken = tweenToken
	activeTweenSequence = true

	task.spawn(function()
		if isUnloaded then return end
		local c = LocalPlayer.Character
		local r = c and c:FindFirstChild("HumanoidRootPart")
		if not c or not r or tweenToken ~= myToken then
			if tweenToken == myToken then
				activeTweenSequence = false
			end
			return
		end

		local startPos = r.Position
		local climbTargetY = startPos.Y + SKY_CLIMB_STUDS

		if not climbStraightToHeight(climbTargetY, targetCFrame.Rotation, startPos.Y, myToken) then
			if tweenToken == myToken then
				activeTweenSequence = false
			end
			return
		end

		local afterClimbPos = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position or startPos
		local aboveTargetCF = CFrame.new(targetCFrame.Position.X, afterClimbPos.Y, targetCFrame.Position.Z) * targetCFrame.Rotation
		local ok2 = tweenSingleSegment(aboveTargetCF, myToken, nil)
		if not ok2 then
			if tweenToken == myToken then
				activeTweenSequence = false
			end
			return
		end

		setNoclip(true)

		local ok3 = tweenSingleSegment(targetCFrame, myToken, nil)
		if not ok3 then
			setNoclip(false)
			if tweenToken == myToken then
				activeTweenSequence = false
			end
			return
		end

		if not isUnloaded and tweenToken == myToken then
			activeTweenSequence = false
			local finalChar = LocalPlayer.Character
			local finalRoot = finalChar and finalChar:FindFirstChild("HumanoidRootPart")
			if finalChar and finalRoot then
				zeroCharacterVelocity(finalChar)
				finalRoot.CFrame = targetCFrame
				if onComplete then
					onComplete(finalChar, finalRoot, targetCFrame)
				end
			end
		end
	end)
end

local function getTargetStandCFrame()
	if customSetPoint then
		return CFrame.new(customSetPoint.X, customSetPoint.Y, customSetPoint.Z)
	end
	local plat = initInitialPlatform()
	local topY = plat and (plat.Position.Y + (plat.Size.Y / 2) + 3.2) or FIXED_PLATFORM_POS.Y
	return CFrame.new(plat and plat.Position.X or FIXED_PLATFORM_POS.X, topY, plat and plat.Position.Z or FIXED_PLATFORM_POS.Z)
end

-- ==========================================
-- HÀNH ĐỘNG LÊN ĐIỂM / TWEEN VỀ VỊ TRÍ CŨ
-- ==========================================
local function goUpToPlatform()
	if isUnloaded then return end
	local char = LocalPlayer.Character
	if not isAliveChar(char) then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")

	if not savedOriginCFrame then
		savedOriginCFrame = hrp.CFrame
	end

	local targetCF = getTargetStandCFrame()

	if role == "owner" then
		setNoclip(true)
		tweenViaSkyToTarget(targetCF, function(finalChar, root)
			zeroCharacterVelocity(finalChar)
			setNoclip(false)
		end)
	else
		setNoclip(true)
		tweenViaSkyToTarget(targetCF, function(finalChar, root, landedCF)
			startFreezeAtCurrentSpot(root, landedCF)
			zeroCharacterVelocity(finalChar)
			setNoclip(false)
		end)
	end
end

local function goBackToOrigin()
	if isUnloaded then return end
	local char = LocalPlayer.Character
	if not isAliveChar(char) then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")

	stopFreeze()
	setNoclip(true)

	local backCF = savedOriginCFrame or hrp.CFrame
	tweenViaSkyToTarget(backCF, function(finalChar, root)
		zeroCharacterVelocity(finalChar)
		setNoclip(false)
		savedOriginCFrame = nil
	end)
end

-- ==========================================
-- AUTO RESET KHI HP <= 97 -> ĐỢI 7S ẤN R -> ĐỢI 2S TWEEN LÊN PLATFORM SET
-- ==========================================
local function pressKeyR()
	if isUnloaded then return end
	pcall(function()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
		task.wait(0.06)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
	end)
	pcall(function()
		if typeof(keytap) == "function" then
			keytap(0x52)
		elseif typeof(keypress) == "function" and typeof(keyrelease) == "function" then
			keypress(0x52)
			task.wait(0.06)
			keyrelease(0x52)
		end
	end)
end

local function forceResetCharacter(char)
	if not char then return end
	cancelActiveTween()
	stopFreeze()
	setNoclip(false)

	local hum = char:FindFirstChildOfClass("Humanoid")
	pcall(function()
		if hum then
			hum.Health = 0
			hum:ChangeState(Enum.HumanoidStateType.Dead)
		end
	end)
	pcall(function()
		char:BreakJoints()
	end)
end

local function triggerAutoReset97Flow(char)
	if isUnloaded or role ~= "alt" or not isAutoReset97 or autoResetBusy then return end
	autoResetBusy = true

	task.spawn(function()
		forceResetCharacter(char)

		-- Đợi 7s rồi ấn R
		task.wait(7)
		if isUnloaded or not isAutoReset97 then
			autoResetBusy = false
			return
		end
		pressKeyR()

		-- Đợi 2s rồi tween lên platform set lại
		task.wait(2)
		autoResetBusy = false
		if not isUnloaded and isAutoReset97 then
			respawnTweenPending = false
			goUpToPlatform()
		end
	end)
end

local function attachHp97Watcher(char)
	if hpWatchConn then
		hpWatchConn:Disconnect()
		hpWatchConn = nil
	end
	if isUnloaded or role ~= "alt" or not char then return end

	local hum = char:WaitForChild("Humanoid", 10)
	if isUnloaded or not hum then return end

	local firedForChar = false
	local function checkHp(hp)
		if isUnloaded or firedForChar or not isAutoReset97 or autoResetBusy then return end
		if hp > 0 and hp <= 97 then
			firedForChar = true
			triggerAutoReset97Flow(char)
		end
	end

	checkHp(hum.Health)
	hpWatchConn = hum.HealthChanged:Connect(checkHp)
end

-- ==========================================
-- THEO DÕI CHẾT & RESPAWN
-- ==========================================
local function hookCharacter(char)
	if isUnloaded then return end
	stopFreeze()
	attachHp97Watcher(char)

	local hum = char:WaitForChild("Humanoid", 10)
	if not isUnloaded and hum then
		hum.Died:Connect(function()
			if isUnloaded then return end
			cancelActiveTween()
			stopFreeze()
			setNoclip(false)

			if role == "alt" and (not isAutoReset97) and (not isButtonMode) and isActive and savedOriginCFrame then
				respawnTweenPending = true
			end
		end)
	end
end

if LocalPlayer.Character then
	hookCharacter(LocalPlayer.Character)
end

trackConn(LocalPlayer.CharacterAdded:Connect(function(newChar)
	if isUnloaded then return end
	hookCharacter(newChar)

	if role == "alt" and (not isAutoReset97) and (not isButtonMode) and isActive and respawnTweenPending and savedOriginCFrame then
		respawnTweenPending = false
		local hrp = newChar:WaitForChild("HumanoidRootPart", 10)
		local hum = newChar:WaitForChild("Humanoid", 10)
		if not isUnloaded and hrp and hum then
			local elapsed = 0
			while not isUnloaded and hum:GetState() == Enum.HumanoidStateType.Dead and elapsed < 3 do
				elapsed += task.wait(0.05)
			end
			if isUnloaded then return end
			task.wait(0.25)
			if isUnloaded then return end
			setNoclip(true)
			tweenViaSkyToTarget(savedOriginCFrame, function(finalChar, root)
				zeroCharacterVelocity(finalChar)
				setNoclip(false)
				savedOriginCFrame = nil
			end)
		end
	end
end))

-- ==========================================
-- UNLOAD TOÀN BỘ SCRIPT, PLATFORM, GUI
-- ==========================================
local function unloadScript()
	if isUnloaded then return end
	isUnloaded = true
	isActive = false
	isAutoReset97 = false
	autoResetBusy = false
	respawnTweenPending = false

	cancelActiveTween()
	stopFreeze()
	setNoclip(false)

	if hpWatchConn then
		hpWatchConn:Disconnect()
		hpWatchConn = nil
	end

	for _, conn in ipairs(connections) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	table.clear(connections)

	if skyPlatform and skyPlatform.Parent then
		pcall(function()
			skyPlatform:Destroy()
		end)
	end
	skyPlatform = nil

	local existingPlat = workspace:FindFirstChild(PLATFORM_NAME)
	if existingPlat then
		pcall(function()
			existingPlat:Destroy()
		end)
	end

	if activeGui and activeGui.Parent then
		pcall(function()
			activeGui:Destroy()
		end)
	end
	activeGui = nil

	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
	if playerGui then
		local existingGui = playerGui:FindFirstChild("SkyPlatformControlGui")
		if existingGui then
			pcall(function()
				existingGui:Destroy()
			end)
		end
	end

	customSetPoint = nil
	savedOriginCFrame = nil
	refreshActionButtonText = nil
	setPlatformFeedback = nil
end

-- ==========================================
-- TẠO GUI
-- ==========================================
local function buildGui()
	if isUnloaded then return end
	local playerGui = LocalPlayer:WaitForChild("PlayerGui")
