-- Điểm được set qua nút SET PLATFORM (nil = dùng vị trí platform cũ mặc định)
local customSetPoint = nil
local savedOriginCFrame = nil
local refreshActionButtonText = nil
local setPlatformFeedback = nil

local function isAliveChar(char)
	if not char or not char.Parent then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp or not hum.Parent or not hrp.Parent then
		return false
	end
	return hum:GetState() ~= Enum.HumanoidStateType.Dead
end

-- ==========================================
-- TẠO 1 PLATFORM DUY NHẤT LÚC ĐẦU (GIỮ NGUYÊN, KHÔNG DI CHUYỂN)
-- ==========================================
local skyPlatform = nil

local function initInitialPlatform()
	if skyPlatform and skyPlatform.Parent then
		return skyPlatform
	end

	local existing = workspace:FindFirstChild(PLATFORM_NAME)
	if existing and existing:IsA("BasePart") then
		skyPlatform = existing
		return skyPlatform
	end

	local part = Instance.new("Part")
	part.Name = PLATFORM_NAME
	part.Size = PLATFORM_SIZE
	part.Position = FIXED_PLATFORM_POS
	part.Anchored = true
	part.CanCollide = true
	part.Material = Enum.Material.SmoothPlastic
	part.Color = (role == "owner") and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(255, 170, 0)
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = workspace

	skyPlatform = part
	return part
end

initInitialPlatform()

-- ==========================================
-- ĐỒNG BỘ ĐIỂM SET QUA CHAT (__SKYPLAT_POINT__)
-- ==========================================
local SYNC_PREFIX = "__SKYPLAT_POINT__:"

local function parseSyncMessage(msg)
	if typeof(msg) ~= "string" then return nil end
	if string.sub(msg, 1, #SYNC_PREFIX) ~= SYNC_PREFIX then return nil end
	local body = string.sub(msg, #SYNC_PREFIX + 1)
	local x, y, z = string.match(body, "^([%-?%d%.]+),([%-?%d%.]+),([%-?%d%.]+)$")
	if x and y and z then
		return Vector3.new(tonumber(x), tonumber(y), tonumber(z))
	end
	return nil
end

local function sendSyncChat(vec3)
	local payload = string.format("%s%.2f,%.2f,%.2f", SYNC_PREFIX, vec3.X, vec3.Y, vec3.Z)
	pcall(function()
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			local general = TextChatService:FindFirstChild("TextChannels")
				and (TextChatService.TextChannels:FindFirstChild("RBXGeneral") or TextChatService.TextChannels:GetChildren()[1])
			if general and general:IsA("TextChannel") then
				general:SendAsync(payload)
				return
			end
		end
	end)
	pcall(function()
		local chatEvents = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
		local sayMsg = chatEvents and chatEvents:FindFirstChild("SayMessageRequest")
		if sayMsg then
			sayMsg:FireServer(payload, "All")
		end
	end)
end

if role == "alt" then
	pcall(function()
		TextChatService.MessageReceived:Connect(function(textChatMessage)
			local sender = textChatMessage.TextSource and Players:GetPlayerByUserId(textChatMessage.TextSource.UserId)
			if sender and sender.Name == OwnerName then
				local pos = parseSyncMessage(textChatMessage.Text)
				if pos then
					customSetPoint = pos
				end
			end
		end)
	end)

	Players.PlayerChatted:Connect(function(_, sender, message)
		if sender and sender.Name == OwnerName then
			local pos = parseSyncMessage(message)
			if pos then
				customSetPoint = pos
			end
		end
	end)
end

-- Ấn nút SET PLATFORM: chỉ lưu điểm hiện tại + gửi __SKYPLAT_POINT__ (không tạo/dời platform)
local function setPointOnly()
	if role ~= "owner" then return end
	local char = LocalPlayer.Character
	if not isAliveChar(char) then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")

	customSetPoint = hrp.Position
	if setPlatformFeedback then
		setPlatformFeedback(customSetPoint)
	end

	sendSyncChat(customSetPoint)
end

-- ==========================================
-- NOCLIP & FREEZE THẬT KIỂU INFINITE YIELD
-- ==========================================
local function setNoclip(enabled)
	if noclipConn then
		noclipConn:Disconnect()
		noclipConn = nil
	end

	if enabled then
		noclipConn = RunService.Stepped:Connect(function()
			local char = LocalPlayer.Character
			if not char then return end
			for _, obj in ipairs(char:GetDescendants()) do
				if obj:IsA("BasePart") then
					obj.CanCollide = false
				end
			end
		end)
	else
		local char = LocalPlayer.Character
		if not char then return end
		for _, obj in ipairs(char:GetDescendants()) do
			if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart" then
				obj.CanCollide = true
			end
		end
	end
end

local function stopFreeze()
	if freezeRenderConn then
		freezeRenderConn:Disconnect()
		freezeRenderConn = nil
	end
	if freezeHeartConn then
		freezeHeartConn:Disconnect()
		freezeHeartConn = nil
	end
	frozenCFrame = nil

	local char = LocalPlayer.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.PlatformStand = false
			pcall(function()
				hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
				hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
			end)
		end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if hrp and hrp:IsA("BasePart") then
			hrp.Anchored = false
		end
	end
end

local function lockRootInPlace()
	local char = LocalPlayer.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not frozenCFrame then return end

	if hum then
		hum.PlatformStand = false
		pcall(function()
			hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
			hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
		end)
	end

	for _, child in ipairs(hrp:GetChildren()) do
		if child:IsA("BodyMover") or child:IsA("LinearVelocity") or child:IsA("AngularVelocity") or child:IsA("VectorForce") then
			child:Destroy()
		end
	end

	hrp.Anchored = true
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	hrp.RotVelocity = Vector3.zero
	hrp.Velocity = Vector3.zero

	if (hrp.CFrame.Position - frozenCFrame.Position).Magnitude > 0.001 or hrp.CFrame ~= frozenCFrame then
		hrp.CFrame = frozenCFrame
	end
end

local function startFreezeAtCurrentSpot(hrp)
	stopFreeze()
	if not hrp or not hrp.Parent then return end

	frozenCFrame = hrp.CFrame
	lockRootInPlace()

	freezeRenderConn = RunService.RenderStepped:Connect(function()
		if not frozenCFrame then
			stopFreeze()
			return
		end
		lockRootInPlace()
	end)

	freezeHeartConn = RunService.Heartbeat:Connect(function()
		if not frozenCFrame then
			stopFreeze()
			return
		end
		lockRootInPlace()
	end)
end

-- ==========================================
-- TWEEN 3 CHẶNG THUẦN (BAY LÊN 700 STUD -> TỚI VỊ TRÍ)
-- ==========================================
local function cancelActiveTween()
	tweenToken += 1
	activeTweenSequence = false
	if currentTween then
		currentTween:Cancel()
		currentTween = nil
	end
end

local function tweenSingleSegment(targetCFrame, myToken)
	local char = LocalPlayer.Character
	if not isAliveChar(char) then return false end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end

	if currentTween then
		currentTween:Cancel()
		currentTween = nil
	end

	local distance = (hrp.Position - targetCFrame.Position).Magnitude
	local duration = math.max(distance / TWEEN_SPEED, 0.03)

	local completed = false
	local cancelled = false

	local info = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
	local tween = TweenService:Create(hrp, info, { CFrame = targetCFrame })
	currentTween = tween

	tween.Completed:Connect(function(state)
		if currentTween == tween then
			currentTween = nil
		end
		if state == Enum.PlaybackState.Completed then
			completed = true
		else
			cancelled = true
		end
	end)

	tween:Play()

	while not completed and not cancelled and activeTweenSequence and (tweenToken == myToken) do
		local c = LocalPlayer.Character
		local r = c and c:FindFirstChild("HumanoidRootPart")
		if not c or not c.Parent or not r or not r.Parent then
			tween:Cancel()
			return false
		end
		local h = c:FindFirstChildOfClass("Humanoid")
		if not h or h:GetState() == Enum.HumanoidStateType.Dead then
			tween:Cancel()
			return false
		end
		task.wait()
	end

	return completed and activeTweenSequence and (tweenToken == myToken)
end

local function tweenViaSkyToTarget(targetCFrame, onComplete)
	local char = LocalPlayer.Character
	if not isAliveChar(char) then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	cancelActiveTween()
	stopFreeze()
	local myToken = tweenToken
	activeTweenSequence = true

	task.spawn(function()
		local c = LocalPlayer.Character
		local r = c and c:FindFirstChild("HumanoidRootPart")
		if not c or not r or tweenToken ~= myToken then
			if tweenToken == myToken then
				activeTweenSequence = false
			end
			return
		end

		local startPos = r.Position
		-- Chặng 1: bay thẳng đứng lên trời 700 stud
		local climbUpCF = CFrame.new(startPos.X, startPos.Y + SKY_CLIMB_STUDS, startPos.Z) * targetCFrame.Rotation
		if not tweenSingleSegment(climbUpCF, myToken) then
			if tweenToken == myToken then
				activeTweenSequence = false
			end
			return
		end

		-- Chặng 2: tween ngang tới tọa độ đích ở độ cao +700 stud
		local aboveTargetCF = CFrame.new(targetCFrame.Position.X, startPos.Y + SKY_CLIMB_STUDS, targetCFrame.Position.Z) * targetCFrame.Rotation
		if not tweenSingleSegment(aboveTargetCF, myToken) then
			if tweenToken == myToken then
				activeTweenSequence = false
			end
			return
		end

		-- Chặng 3: hạ xuống đúng điểm đích
		if not tweenSingleSegment(targetCFrame, myToken) then
			if tweenToken == myToken then
				activeTweenSequence = false
			end
			return
		end

		if tweenToken == myToken then
			activeTweenSequence = false
			local finalChar = LocalPlayer.Character
			local finalRoot = finalChar and finalChar:FindFirstChild("HumanoidRootPart")
			if finalChar and finalRoot and onComplete then
				onComplete(finalChar, finalRoot)
			end
		end
	end)
end

local function getTargetStandCFrame()
	if customSetPoint then
		return CFrame.new(customSetPoint.X, customSetPoint.Y + 3.2, customSetPoint.Z)
	end
	local plat = initInitialPlatform()
	local topY = plat.Position.Y + (plat.Size.Y / 2) + 3.2
	return CFrame.new(plat.Position.X, topY, plat.Position.Z)
end

-- ==========================================
-- HÀNH ĐỘNG LÊN ĐIỂM / TWEEN VỀ VỊ TRÍ CŨ
-- ==========================================
local function goUpToPlatform()
	local char = LocalPlayer.Character
	if not isAliveChar(char) then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")

	if not savedOriginCFrame then
		savedOriginCFrame = hrp.CFrame
	end

	local targetCF = getTargetStandCFrame()

	if role == "owner" then
		setNoclip(true)
		tweenViaSkyToTarget(targetCF, function(_, root)
			setNoclip(false)
			root.AssemblyLinearVelocity = Vector3.zero
		end)
	else
		setNoclip(false)
		tweenViaSkyToTarget(targetCF, function(_, root)
			setNoclip(false)
			startFreezeAtCurrentSpot(root)
		end)
	end
end

local function goBackToOrigin()
	local char = LocalPlayer.Character
	if not isAliveChar(char) then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")

	stopFreeze()
	setNoclip(true)

	local backCF = savedOriginCFrame or hrp.CFrame
	tweenViaSkyToTarget(backCF, function(_, root)
		setNoclip(false)
		savedOriginCFrame = nil
		root.AssemblyLinearVelocity = Vector3.zero
	end)
end

-- ==========================================
-- AUTO RESET KHI HP = 97 -> ĐỢI 7S ẤN R -> ĐỢI 2S TWEEN LÊN PLATFORM SET
-- ==========================================
local function pressKeyR()
	pcall(function()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
		task.wait(0.06)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
	end)
	pcall(function()
		if typeof(keytap) == "function" then
			keytap(0x52) -- 'R'
		elseif typeof(keypress) == "function" and typeof(keyrelease) == "function" then
			keypress(0x52)
			task.wait(0.06)
			keyrelease(0x52)
		end
	end)
end

local function forceResetCharacter(char)
	if not char then return end
	cancelActiveTween()
	stopFreeze()
	setNoclip(false)

	local hum = char:FindFirstChildOfClass("Humanoid")
	pcall(function()
		if hum then
			hum.Health = 0
			hum:ChangeState(Enum.HumanoidStateType.Dead)
		end
	end)
	pcall(function()
		char:BreakJoints()
	end)
end

local function triggerAutoReset97Flow(char)
	if role ~= "alt" or not isAutoReset97 or autoResetBusy then return end
	autoResetBusy = true

	task.spawn(function()
		forceResetCharacter(char)

		-- Đợi 7s rồi ấn R
		task.wait(7)
		if not isAutoReset97 then
			autoResetBusy = false
			return
		end
		pressKeyR()

		-- Đợi 2s rồi tween lên platform set lại
		task.wait(2)
		autoResetBusy = false
		if isAutoReset97 then
			respawnTweenPending = false
			goUpToPlatform()
		end
	end)
end

local function attachHp97Watcher(char)
	if hpWatchConn then
		hpWatchConn:Disconnect()
		hpWatchConn = nil
	end
	if role ~= "alt" or not char then return end

	local hum = char:WaitForChild("Humanoid", 10)
	if not hum then return end

	local firedForChar = false
	hpWatchConn = hum.HealthChanged:Connect(function(newHp)
		if firedForChar or not isAutoReset97 or autoResetBusy then return end
		if math.abs(newHp - 97) < 0.01 then
			firedForChar = true
			triggerAutoReset97Flow(char)
		end
	end)
end

-- ==========================================
-- THEO DÕI CHẾT & RESPAWN (TỰ TWEEN VỀ KHI CHẾT TRÊN ALT TOGGLE)
-- ==========================================
local function hookCharacter(char)
	stopFreeze()
	attachHp97Watcher(char)

	local hum = char:WaitForChild("Humanoid", 10)
	if hum then
		hum.Died:Connect(function()
			cancelActiveTween()
			stopFreeze()
			setNoclip(false)

			if role == "alt" and (not isAutoReset97) and (not isButtonMode) and isActive and savedOriginCFrame then
				respawnTweenPending = true
			end
		end)
	end
end

if LocalPlayer.Character then
	hookCharacter(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(function(newChar)
	hookCharacter(newChar)

	if role == "alt" and (not isAutoReset97) and (not isButtonMode) and isActive and respawnTweenPending and savedOriginCFrame then
		respawnTweenPending = false
		local hrp = newChar:WaitForChild("HumanoidRootPart", 10)
		local hum = newChar:WaitForChild("Humanoid", 10)
		if hrp and hum then
			local elapsed = 0
			while hum:GetState() == Enum.HumanoidStateType.Dead and elapsed < 3 do
				elapsed += task.wait(0.05)
			end
			task.wait(0.25)
			setNoclip(true)
			tweenViaSkyToTarget(savedOriginCFrame, function(_, root)
				setNoclip(false)
				savedOriginCFrame = nil
				root.AssemblyLinearVelocity = Vector3.zero
			end)
		end
	end
end)

